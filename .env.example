PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key

# Optional: client-side error tracking (Sentry browser DSN)
PUBLIC_SENTRY_DSN=
PUBLIC_SENTRY_ENVIRONMENT=development

# Optional: Google Analytics measurement ID
PUBLIC_GA_MEASUREMENT_ID=

# Optional: GitHub Pages base path (set to /repo-name/ for project sites)
GITHUB_PAGES_BASE=/

# Contact form email notifications (Supabase Edge Function secrets, not public browser env)
# Gmail test flow uses a Google Apps Script web app as CONTACT_EMAIL_WEBHOOK_URL.
CONTACT_EMAIL_WEBHOOK_URL=
CONTACT_EMAIL_WEBHOOK_SECRET=
CONTACT_NOTIFICATION_TO=josueuzj9@gmail.com