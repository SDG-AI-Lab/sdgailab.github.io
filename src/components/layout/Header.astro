---
import { withBase } from '../../lib/url';
import logo from '../../../assets/img/sdg-ai-lab-logo.png';
import icpsdLogo from '../../../assets/img/ICPSD-logo-navbar.png';
import undpLogo from '../../../assets/img/UNDP_logo.svg';

const pathname = Astro.url.pathname;
const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '') || '';

const navLinks = [
  { href: withBase('/'), label: 'Home' },
  { href: withBase('/about'), label: 'How we work' },
  { href: withBase('/projects'), label: 'Our projects' },
  { href: withBase('/services'), label: 'Our services' },
  { href: withBase('/resources'), label: 'Publications' },
  { href: withBase('/news'), label: 'News' },
  { href: withBase('/team'), label: 'Team' },
  { href: withBase('/contact'), label: 'Contact' },
  { href: withBase('/volunteer'), label: 'Become a Volunteer' },
];

const desktopNavLinks = navLinks.filter((link) => link.label !== 'Home' && link.label !== 'Become a Volunteer');


function isActive(href: string): boolean {
  const rootHref = base + '/' || '/';
  if (href === rootHref || (base && href === base)) {
    return pathname === rootHref || pathname === base || pathname === '/';
  }
  return pathname === href || pathname.startsWith(href + '/');
}
---

<header class="sticky top-0 z-50 border-b border-lab-border bg-lab-base/95 text-lab-text backdrop-blur-xl">
  <nav
    aria-label="Main navigation"
    class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8"
  >
    <a href={withBase('/')} class="flex shrink-0 items-center gap-2 text-lab-text">
      <img
        src={logo.src}
        width={logo.width}
        height={logo.height}
        alt="SDG AI Lab"
        class="h-10 w-auto rounded-sm"
        decoding="async"
      />
      <span>
        <span class="block text-sm font-black leading-tight text-lab-text xl:text-base">SDG AI Lab</span>
        <span class="hidden text-[10px] font-bold uppercase tracking-wider text-lab-muted xl:block">A UNDP initiative</span>
      </span>
    </a>

    <ul class="hidden items-center gap-2 lg:flex">
      {
        desktopNavLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                'block rounded-full px-3 py-2 text-xs font-bold transition-colors xl:text-sm',
                isActive(link.href)
                  ? 'bg-lab-accent text-lab-text shadow-sm'
                  : 'text-lab-muted hover:bg-lab-surface/55 hover:text-lab-accent-soft',
              ]}
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="hidden shrink-0 items-center gap-3 lg:flex" aria-label="Institutional logos">
      <img src={icpsdLogo.src} width={icpsdLogo.width} height={icpsdLogo.height} alt="ICPSD" class="h-9 w-auto object-contain" decoding="async" />
      <img src={undpLogo.src} width={undpLogo.width} height={undpLogo.height} alt="UNDP" class="h-10 w-auto object-contain" decoding="async" />
    </div>

    <button
      type="button"
      id="mobile-menu-toggle"
      class="inline-flex items-center justify-center rounded p-2 text-lab-text hover:bg-lab-surface/60 hover:text-lab-accent-soft lg:hidden focus:outline-none focus-visible:ring-2 focus-visible:ring-lab-accent focus-visible:ring-offset-2 focus-visible:ring-offset-lab-base"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Toggle navigation menu"
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
        <path class="menu-icon" stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
        <path class="close-icon hidden" stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-lab-border bg-lab-surface lg:hidden">
    <ul class="container-narrow space-y-1 py-3">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                'block rounded px-3 py-2 text-sm font-bold transition-colors',
                isActive(link.href)
                  ? 'bg-lab-accent text-lab-text'
                  : 'text-lab-muted hover:bg-lab-surface/60 hover:text-lab-accent-soft',
              ]}
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="flex items-center gap-3 px-3 pt-2" aria-label="Institutional logos">
        <img src={icpsdLogo.src} width={icpsdLogo.width} height={icpsdLogo.height} alt="ICPSD" class="h-9 w-auto object-contain" decoding="async" />
        <img src={undpLogo.src} width={undpLogo.width} height={undpLogo.height} alt="UNDP" class="h-10 w-auto object-contain" decoding="async" />
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    const toggleButton = toggle;
    const menuPanel = menu;
    const menuIcon = toggleButton.querySelector('.menu-icon');
    const closeIcon = toggleButton.querySelector('.close-icon');

    function closeMenu() {
      toggleButton.setAttribute('aria-expanded', 'false');
      menuPanel.classList.add('hidden');
      menuIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      toggleButton.focus();
    }

    function openMenu() {
      toggleButton.setAttribute('aria-expanded', 'true');
      menuPanel.classList.remove('hidden');
      menuIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
      const firstLink = menuPanel.querySelector('a');
      firstLink?.focus();
    }

    toggleButton.addEventListener('click', () => {
      const isOpen = toggleButton.getAttribute('aria-expanded') === 'true';
      if (isOpen) closeMenu();
      else openMenu();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggleButton.getAttribute('aria-expanded') === 'true') {
        closeMenu();
      }
    });
  }
</script>




