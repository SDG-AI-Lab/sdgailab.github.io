---
import { withBase } from '../../lib/url';
const pathname = Astro.url.pathname;
const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '') || '';

const navLinks = [
  { href: withBase('/'), label: 'Home' },
  { href: withBase('/about'), label: 'About' },
  { href: withBase('/focus-areas'), label: 'Areas of Expertise' },
  { href: withBase('/services'), label: 'Services' },
  { href: withBase('/projects'), label: 'Our Work', activePath: withBase('/projects') },
  { href: withBase('/research'), label: 'Research' },
];

const mobileLinks = [
  ...navLinks,
  { href: withBase('/contact'), label: "Let's talk" },
];

function isActive(link: { href: string; activePath?: string }): boolean {
  const href = link.activePath ?? link.href;
  const cleanHref = href.split('#')[0];
  const rootHref = base + '/' || '/';
  if (cleanHref === rootHref || (base && cleanHref === base)) {
    return pathname === rootHref || pathname === base || pathname === '/';
  }
  return pathname === cleanHref || pathname.startsWith(cleanHref + '/');
}
---

<header class="marina-header">
  <nav aria-label="Main navigation" class="marina-wrap marina-nav">
    <div class="marina-nav-brand-group">
      <img src="https://sdg-dark.netlify.app/assets/undp-logo.png" alt="UNDP" class="marina-nav-partner-logo marina-nav-undp" decoding="async" />
      <a href={withBase('/')} class="marina-nav-logo" aria-label="SDG AI Lab homepage"><img src="https://sdg-dark.netlify.app/logo-white.png" alt="SDG AI Lab" decoding="async" /></a>
      <img src="https://sdg-dark.netlify.app/assets/icpsd-logo.png" alt="ICPSD" class="marina-nav-partner-logo" decoding="async" />
    </div>

    <ul class="marina-nav-links" role="list">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={['marina-nav-link', { 'is-section-active': link.label === 'Our Work' && pathname.startsWith(withBase('/programmes')) }]}
              aria-current={isActive(link) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="marina-nav-cta">
      <a href={withBase('/contact')} class="marina-button marina-button--primary marina-button--small">
        Let&rsquo;s talk
      </a>
    </div>

    <button
      type="button"
      id="mobile-menu-toggle"
      class="marina-mobile-toggle"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Toggle navigation menu"
    >
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
        <path class="menu-icon" stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16"></path>
        <path class="close-icon hidden" stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </nav>

  <div id="mobile-menu" class="marina-mobile-menu">
    <ul class="marina-wrap" role="list">
      {
        mobileLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="marina-mobile-link"
              aria-current={isActive(link) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    const toggleButton = toggle;
    const menuPanel = menu;
    const menuIcon = toggleButton.querySelector('.menu-icon');
    const closeIcon = toggleButton.querySelector('.close-icon');

    function closeMenu() {
      toggleButton.setAttribute('aria-expanded', 'false');
      menuPanel.classList.remove('is-open');
      menuIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    }

    function openMenu() {
      toggleButton.setAttribute('aria-expanded', 'true');
      menuPanel.classList.add('is-open');
      menuIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
      const firstLink = menuPanel.querySelector('a');
      firstLink?.focus();
    }

    toggleButton.addEventListener('click', () => {
      const isOpen = toggleButton.getAttribute('aria-expanded') === 'true';
      if (isOpen) closeMenu();
      else openMenu();
    });

    menuPanel.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        if (toggleButton.getAttribute('aria-expanded') === 'true') closeMenu();
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggleButton.getAttribute('aria-expanded') === 'true') {
        closeMenu();
      }
    });
  }
</script>


