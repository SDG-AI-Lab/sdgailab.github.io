---
import { withBase } from '../../lib/url';

const currentYear = new Date().getFullYear();

const quickLinks = [
  { href: withBase('/about'), label: 'About' },
  { href: withBase('/projects'), label: 'Projects' },
  { href: withBase('/services'), label: 'Services' },
  { href: withBase('/volunteer'), label: 'Become a volunteer' },
  { href: withBase('/contact'), label: 'Contact' },
];
---

<footer class="bg-primary-dark text-white">
  <div class="container-narrow py-12 sm:py-16">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
      {/* Branding */}
      <div>
        <a href={withBase('/')} class="text-xl font-bold text-white">SDG AI Lab</a>
        <p class="mt-3 text-sm leading-relaxed text-gray-300">
          Harnessing Artificial Intelligence for Sustainable Development. A UNDP initiative exploring how frontier technologies can accelerate progress on the Sustainable Development Goals.
        </p>
      </div>

      {/* Explore */}
      <div>
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-gray-300">Explore</h3>
        <ul class="space-y-2">
          {quickLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-gray-300 transition-colors hover:text-white"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Connect */}
      <div>
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-gray-300">Connect</h3>
        <ul class="space-y-3">
          <li class="flex items-start gap-2">
            <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
            </svg>
            <a href="mailto:sdgailab@undp.org" class="text-sm text-gray-300 transition-colors hover:text-white">
              sdgailab@undp.org
            </a>
          </li>
          <li class="flex items-start gap-2">
            <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-gray-400" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.447-2.136 2.942v5.664H9.351V9h3.414v1.561h.049c.476-.9 1.637-1.852 3.369-1.852 3.602 0 4.267 2.371 4.267 5.455v6.288zM5.337 7.433a2.063 2.063 0 1 1 0-4.126 2.063 2.063 0 0 1 0 4.126zM7.114 20.452H3.558V9h3.556v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z" />
            </svg>
            <a href="https://www.linkedin.com/company/sdgailab" target="_blank" rel="noopener noreferrer" class="text-sm text-gray-300 transition-colors hover:text-white">
              LinkedIn
            </a>
          </li>
          <li class="flex items-start gap-2">
            <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-gray-400" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
            </svg>
            <a href="https://github.com/SDG-AI-Lab" target="_blank" rel="noopener noreferrer" class="text-sm text-gray-300 transition-colors hover:text-white">
              SDG-AI-Lab
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  {/* Bottom bar */}
  <div class="border-t border-white/10">
    <div class="container-narrow py-4">
      <p class="text-center text-xs text-gray-400">
        &copy; {currentYear} SDG AI Lab, UNDP. All rights reserved.
      </p>
    </div>
  </div>
</footer>
