---
import { withBase } from '../../lib/url';

const currentYear = new Date().getFullYear();

const primaryLinks = [
  { href: withBase('/about'), label: 'About us' },
  { href: withBase('/projects'), label: 'Projects' },
  { href: withBase('/services'), label: 'Services' },
  // { href: withBase('/resources'), label: 'Publications' },
];

const secondaryLinks = [
  { href: withBase('/team'), label: 'Team' },
  { href: withBase('/volunteer'), label: 'Become a Volunteer' },
  { href: withBase('/contact'), label: 'Contact' },
];
---

<footer class="bg-lab-section text-lab-text">
  <div class="container-narrow py-12 sm:py-16">
    <div
      class="grid gap-10 border-b border-lab-border pb-10 sm:grid-cols-2 lg:grid-cols-4"
    >
      <div class="lg:col-span-2">
        <a href={withBase('/')} class="text-xl font-black text-lab-text"
          >SDG AI Lab</a
        >
        <p
          class="mt-3 max-w-md text-sm font-semibold leading-relaxed text-lab-muted"
        >
          Harnessing Artificial Intelligence for Sustainable Development. A UNDP
          initiative exploring how frontier technologies can accelerate progress
          on the Sustainable Development Goals.
        </p>
      </div>

      <nav aria-label="Footer primary links">
        <h3
          class="mb-4 text-xs font-black uppercase tracking-[0.16em] text-lab-muted"
        >
          Explore
        </h3>
        <ul class="space-y-2">
          {
            primaryLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm font-bold text-lab-muted transition-colors hover:text-lab-accent-soft"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <nav aria-label="Footer team links">
          <h3
            class="mb-4 text-xs font-black uppercase tracking-[0.16em] text-lab-muted"
          >
            People
          </h3>
          <ul class="space-y-2">
            {
              secondaryLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm font-bold text-lab-muted transition-colors hover:text-lab-accent-soft"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="mt-8">
          <h3
            class="mb-4 text-xs font-black uppercase tracking-[0.16em] text-lab-muted"
          >
            Connect
          </h3>
          <ul class="space-y-3">
            <li>
              <a
                href="mailto:sdgailab@undp.org"
                class="inline-flex items-center gap-2 text-sm font-bold text-lab-muted transition-colors hover:text-lab-accent-soft"
              >
                <svg
                  class="h-4 w-4 shrink-0"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path
                    d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2Z"
                  ></path>
                  <path d="m22 6-10 7L2 6"></path>
                </svg>
                sdgailab@undp.org
              </a>
            </li>
            <li>
              <a
                href="https://www.linkedin.com/company/sdgailab"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-sm font-bold text-lab-muted transition-colors hover:text-lab-accent-soft"
              >
                <svg
                  class="h-4 w-4 shrink-0"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path
                    d="M20.45 20.45h-3.56v-5.58c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.95v5.67H9.34V8.98h3.42v1.57h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.29ZM5.32 7.41a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12Zm1.78 13.04H3.54V8.98H7.1v11.47ZM22.23 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.46c.98 0 1.77-.77 1.77-1.72V1.72C24 .77 23.21 0 22.23 0Z"
                  ></path>
                </svg>
                LinkedIn
              </a>
            </li>
            <li>
              <a
                href="https://github.com/SDG-AI-Lab"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-sm font-bold text-lab-muted transition-colors hover:text-lab-accent-soft"
              >
                <svg
                  class="h-4 w-4 shrink-0"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path
                    fill-rule="evenodd"
                    clip-rule="evenodd"
                    d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .98-.31 3.2 1.18A11.1 11.1 0 0 1 12 5.97c.99 0 1.98.13 2.91.39 2.22-1.49 3.19-1.18 3.19-1.18.64 1.59.24 2.76.12 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.41-5.27 5.69.41.36.78 1.06.78 2.14 0 1.54-.01 2.79-.01 3.17 0 .31.21.68.8.56A11.5 11.5 0 0 0 12 .5Z"
                  ></path>
                </svg>
                SDG-AI-Lab
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <p class="pt-8 text-center text-xs font-semibold text-lab-subtle">
      &copy; {currentYear} SDG AI Lab, UNDP. All rights reserved.
    </p>
  </div>
</footer>
