---
import { withBase } from '../lib/url';
import BaseLayout from '../components/layout/BaseLayout.astro';
import PartnerLogos from '../islands/PartnerLogos';

const marinaAsset = (path: string) => `https://sdg-dark.netlify.app/${path}`;
const galleryTiles = [
  {
    name: 'Tech4R',
    location: 'Volunteer response',
    color: 'var(--lab-teal)',
    image: 'assets/hero-tech4r.jpg',
    alt: 'Tech4R volunteers working a live coordination session',
  },
  {
    name: 'DSVI',
    location: 'Georgia',
    color: 'var(--lab-accent)',
    image: 'assets/dsvi-georgia-map.jpg',
    alt: 'DSVI drivetime access map, Georgia',
  },
  {
    name: 'Frontier Tech Leaders',
    location: 'Cohort graduation',
    color: 'var(--lab-light-blue)',
    image: 'assets/hero-ftl-graduation.jpg',
    alt: 'Frontier Tech Leaders cohort graduation',
  },
  {
    name: 'Innovation Campus',
    location: 'Türkiye',
    color: 'var(--lab-accent)',
    image: 'assets/hero-innovation-campus.jpg',
    alt: 'Innovation Campus graduates with Samsung',
  },
  {
    name: 'Game Dev Bootcamp',
    location: 'UAE',
    color: 'var(--lab-teal)',
    image: 'assets/hero-gamedev-uae.jpg',
    alt: 'Game Development Bootcamp cohort, UAE',
  },
];
const impactStats = [
  { value: 2087, label: 'People trained via Frontier Tech Leaders' },
  { value: 90, suffix: '%', label: 'Innovation Campus employment rate' },
  { value: 5000, label: 'Youth trained in Game Dev Bootcamps' },
  { value: 5, label: 'Countries mapped by DSVI' },
];
---

<BaseLayout
  title="SDG AI Lab — Digital Technologies for the SDGs"
  description="SDG AI Lab helps UNDP units and development partners turn emerging technologies into practical solutions for real-world development challenges."
>
  <div class="marina-live-home">
    <section class="marina-live-hero" aria-labelledby="home-hero-heading">
      <div class="marina-live-hero-blob" aria-hidden="true"></div><div
        class="marina-live-hero-grid"
        aria-hidden="true"
      >
      </div><span class="marina-live-hero-orb" aria-hidden="true"></span><div
        class="marina-live-wheel-shade"
        aria-hidden="true"
      >
      </div>
      <div class="marina-live-wrap">
        <p class="marina-live-hero-badge" aria-hidden="true">
          We build for impact
        </p>
        <div class="marina-live-hero-top">
          <h1 id="home-hero-heading">
            <span class="marina-live-title-line">Digital technologies</span
            ><span class="marina-live-title-line weak">for the</span><span
              class="marina-live-title-line grad marina-live-title-sustainable"
              >Sustainable</span
            ><span class="marina-live-title-line grad marina-live-title-goals"
              >Development Goals.</span
            >
          </h1>
        </div>
        <div class="marina-live-hero-sub">
          <p class="lede">
            The SDG AI Lab helps UNDP units and development partners turn
            emerging technologies into practical solutions for real-world
            development challenges.
          </p><a
            class="marina-live-watch-link"
            href={withBase('/services#approach')}
            ><span class="ring" aria-hidden="true"
              ><svg viewBox="0 0 10 12" fill="none"
                ><path d="M1 1L9 6L1 11V1Z" fill="currentColor"></path></svg
              ></span
            >How we work</a
          >
        </div>
        <div
          class="marina-live-gallery reveal"
          id="projects-preview"
          aria-label="Selected work"
        >
          <div class="marina-live-gallery-inner">
            {
              [galleryTiles, galleryTiles].map((tiles, setIndex) => (
                <div
                  class="marina-live-gallery-track"
                  aria-hidden={setIndex === 1 ? 'true' : undefined}
                >
                  {tiles.map((tile) => (
                    <article class="marina-live-work-tile">
                      <div class="marina-live-work-art">
                        <img
                          src={marinaAsset(tile.image)}
                          alt={setIndex === 0 ? tile.alt : ''}
                          loading={setIndex === 0 ? 'eager' : 'lazy'}
                          decoding="async"
                        />
                      </div>
                      <div class="marina-live-work-caption">
                        <span>{tile.name}</span>
                        <small>{tile.location}</small>
                      </div>
                    </article>
                  ))}
                </div>
              ))
            }
          </div>
        </div>
        <p class="marina-live-hero-note">
          A joint initiative of the <strong
            >UNDP BPPS Data, AI &amp; Innovation Hub</strong
          > and the <strong>Sustainable Finance Hub</strong>, hosted under
          ICPSD.
        </p>
      </div>
    </section>
    <section class="marina-live-mission">
      <div class="marina-live-wrap reveal">
        <p>
          We believe technology only counts once it's <strong
            >running inside the institution that owns the problem.</strong
          >
        </p>
      </div>
    </section>
    <section class="marina-live-band" aria-label="Impact indicators">
      <div class="marina-live-wrap">
        <div class="marina-live-impact">
          {
            impactStats.map((stat) => (
              <article class="marina-live-impact-item reveal">
                <>
                  <span
                    class="number"
                    data-count={stat.value}
                    data-suffix={stat.suffix ?? ''}
                  >
                    {stat.value.toLocaleString('en-US')}
                    {stat.suffix}
                  </span>
                  <span class="label">{stat.label}</span>
                </>
              </article>
            ))
          }
        </div>
      </div>
    </section>
    <section
      class="marina-live-band marina-live-partners"
      aria-labelledby="partners-heading"
    >
      <div class="marina-live-wrap">
        <h2 id="partners-heading" class="reveal">
          Who we <span>build with.</span>
        </h2>
        <div class="reveal">
          <PartnerLogos client:load variant="home" />
        </div>
      </div>
    </section>
  </div>
  <button class="marina-live-to-top" type="button" aria-label="Back to top"
    ><svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"></path></svg
    ></button
  >
  <script>
    const revealItems = document.querySelectorAll('.marina-live-home .reveal');
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) =>
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }),
        { threshold: 0.12 },
      );
      revealItems.forEach((item) => observer.observe(item));
    } else revealItems.forEach((item) => item.classList.add('is-visible'));
    const counters = document.querySelectorAll<HTMLElement>(
      '.marina-live-home [data-count]',
    );
    if (
      'IntersectionObserver' in window &&
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches
    ) {
      const observer = new IntersectionObserver(
        (entries) =>
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            observer.unobserve(entry.target);
            const element = entry.target as HTMLElement;
            const target = Number(element.dataset.count || 0);
            const suffix = element.dataset.suffix || '';
            const start = performance.now();
            const tick = (now: number) => {
              const progress = Math.min((now - start) / 1400, 1);
              element.textContent = `${Math.round(target * (1 - Math.pow(1 - progress, 3))).toLocaleString('en-US')}${suffix}`;
              if (progress < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          }),
        { threshold: 0.4 },
      );
      counters.forEach((counter) => observer.observe(counter));
    }
    const hero = document.querySelector<HTMLElement>('.marina-live-hero');
    hero?.addEventListener('mousemove', (event) => {
      const bounds = hero.getBoundingClientRect();
      hero.style.setProperty(
        '--mx',
        `${((event.clientX - bounds.left) / bounds.width) * 100}%`,
      );
      hero.style.setProperty(
        '--my',
        `${((event.clientY - bounds.top) / bounds.height) * 100}%`,
      );
    });
    const toTop = document.querySelector<HTMLButtonElement>(
      '.marina-live-to-top',
    );
    const updateToTop = () =>
      toTop?.classList.toggle('is-visible', window.scrollY > 900);
    updateToTop();
    window.addEventListener('scroll', updateToTop, { passive: true });
    toTop?.addEventListener('click', () =>
      window.scrollTo({ top: 0, behavior: 'smooth' }),
    );
  </script>
</BaseLayout>
