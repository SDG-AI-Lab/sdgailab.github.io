---
import { withBase } from '../lib/url';
import BaseLayout from '../components/layout/BaseLayout.astro';
import ParticlesHero from '../components/sections/ParticlesHero.astro';
import SDGWheel from '../components/ui/SDGWheel.astro';
import StatsCards from '../islands/StatsCards';
import FeaturedProjects from '../islands/FeaturedProjects';
import PartnerLogos from '../islands/PartnerLogos';
import GeographicReach from '../islands/GeographicReach';
import NewsList from '../islands/NewsList';
import { labServiceLines } from '../data/sampleContent';

const publicationCards = [
  ['Research notes', 'Methods, lessons and findings from applied AI and data-science work.'],
  ['Toolkits', 'Reusable templates, checklists and practical guidance for development teams.'],
  ['Open-source outputs', 'Approved repositories, model cards, data statements and implementation notes.'],
];
---

<BaseLayout
  title="SDG AI Lab | Practical AI and data solutions for development"
  description="A UNDP initiative helping country offices, governments and partners turn development challenges into responsible AI, data and digital solutions."
>
  <main class="wire-home">
    <ParticlesHero>
      <section class="wire-sec wire-hero" aria-labelledby="hero-heading">
        <div class="wire-row">
          <div class="wire-col wire-col-copy">
            <p class="wire-eyebrow">A UNDP initiative</p>
            <h1 id="hero-heading" class="wire-title wire-title-xl" aria-label="Turning development challenges into reusable AI and data solutions">Turning development challenges into <span class="wire-title-accent">reusable AI and data solutions</span></h1>
            <p class="wire-sub wire-sub-lg">
              SDG AI Lab supports UNDP Country Offices, governments and partners with practical tools, technical advisory and responsible innovation methods that can move from exploration to implementation.
            </p>
            <div class="wire-actions">
              <a href={withBase('/contact')} data-analytics-event="cta_click" data-analytics-category="homepage" data-analytics-label="Hero partner with us" class="wire-btn wire-btn-solid">
                Partner with us
              </a>
              <a href={withBase('/projects')} data-analytics-event="cta_click" data-analytics-category="homepage" data-analytics-label="Hero explore projects" class="wire-btn">
                Explore projects
              </a>
            </div>
            <p class="wire-mini">Support areas: discovery, data readiness, AI prototyping, GIS, NLP, public finance tools, advisory, training and partnerships.</p>
          </div>
          <div class="wire-col">
            <div class="wire-media wire-media-hero" aria-label="SDG wheel visual">
              <SDGWheel class="mx-auto h-56 w-56 sm:h-64 sm:w-64" />
            </div>
          </div>
        </div>
      </section>
    </ParticlesHero>

    <section class="wire-sec wire-alt" aria-label="UNDP affiliation">
        <div class="wire-affiliation">
          <p class="wire-eyebrow">Institutional home</p>
          <p>SDG AI Lab is a UNDP initiative hosted by the Istanbul International Centre for Private Sector in Development, working with UNDP teams and partners to apply AI and data responsibly for development priorities.</p>
        </div>
      </section>

    <section class="wire-sec" aria-labelledby="impact-heading">
        <div class="wire-section-head">
          <div>
            <p class="wire-eyebrow">Impact</p>
            <h2 id="impact-heading" class="wire-title wire-title-lg">Impact at a glance</h2>
          </div>
          <a href={withBase('/about#impact')} class="wire-link">View impact evidence &rarr;</a>
        </div>
        <StatsCards client:load />
      </section>

    <section class="wire-sec" aria-labelledby="reach-heading">
        <p class="wire-eyebrow">Where we work</p>
        <h2 id="reach-heading" class="wire-title wire-title-lg">Geographic reach</h2>
        <div class="wire-map">
          <GeographicReach client:load />
        </div>
      </section>

    <section class="wire-sec wire-alt" aria-labelledby="projects-heading">
        <div class="wire-section-head">
          <div>
            <p class="wire-eyebrow">Selected work</p>
            <h2 id="projects-heading" class="wire-title wire-title-lg">Current projects</h2>
          </div>
          <a href={withBase('/projects')} class="wire-btn">View all projects &rarr;</a>
        </div>
        <FeaturedProjects client:load limit={3} />
      </section>

    <section class="wire-sec" aria-labelledby="case-study-heading">
        <div class="wire-row wire-case-study">
          <div class="wire-col"><div class="wire-media wire-media-photo">Photo / product visual</div></div>
          <div class="wire-col">
            <p class="wire-eyebrow">Results in context</p>
            <h2 id="case-study-heading" class="wire-title wire-title-md">Short outcome story</h2>
            <p class="wire-sub">Project pages should read as evidence stories: context, challenge, solution, what changed and what can be reused.</p>
            <a href={withBase('/projects')} class="wire-btn">Read case studies &rarr;</a>
          </div>
        </div>
      </section>

    <section class="wire-sec wire-alt" aria-labelledby="partners-heading">
        <p class="wire-eyebrow">Working across the ecosystem</p>
        <h2 id="partners-heading" class="wire-title wire-title-lg">Partners and network</h2>
        <PartnerLogos client:load variant="marquee" />
      </section>

    <section class="wire-sec" aria-labelledby="services-heading">
        <div class="wire-section-head">
          <div>
            <p class="wire-eyebrow">Services</p>
            <h2 id="services-heading" class="wire-title wire-title-lg">Ways the Lab can support teams and partners</h2>
          </div>
          <a href={withBase('/services')} class="wire-btn">View services &rarr;</a>
        </div>
        <div class="wire-grid wire-grid-3">
          {labServiceLines.map(({ title, body }) => (
            <article class="wire-card wire-card-compact">
              <h3 class="wire-title wire-title-md">{title}</h3>
              <p class="wire-sub">{body}</p>
            </article>
          ))}
        </div>
      </section>

    <section class="wire-sec wire-alt" aria-labelledby="news-heading">
        <div class="wire-section-head">
          <div>
            <p class="wire-eyebrow">Latest news</p>
            <h2 id="news-heading" class="wire-title wire-title-lg">News and updates</h2>
          </div>
          <a href={withBase('/news')} class="wire-btn">View all news &rarr;</a>
        </div>
        <NewsList client:load />
      </section>

    <section class="wire-sec" aria-labelledby="publications-heading">
        <div class="wire-section-head">
          <div>
            <p class="wire-eyebrow">Knowledge products</p>
            <h2 id="publications-heading" class="wire-title wire-title-lg">Publications and resources</h2>
          </div>
          <a href={withBase('/resources')} class="wire-btn">View resources &rarr;</a>
        </div>
        <div class="wire-grid wire-grid-3">
          {publicationCards.map(([title, body]) => (
            <article class="wire-card wire-card-compact">
              <h3 class="wire-title wire-title-md">{title}</h3>
              <p class="wire-sub">{body}</p>
            </article>
          ))}
        </div>
      </section>

    <section class="wire-sec wire-alt" aria-labelledby="capacity-heading">
        <h2 id="capacity-heading" class="wire-title wire-title-md">Join the volunteer data-scientist network</h2>
        <p class="wire-sub">Contribution pathways include volunteer expertise, technical mentoring and research collaboration.</p>
        <a href={withBase('/volunteer')} class="wire-btn wire-btn-solid">Learn how to contribute</a>
      </section>

      <section class="wire-sec wire-convert" aria-labelledby="convert-heading">
        <p class="wire-eyebrow">Work with us</p>
        <h2 id="convert-heading" class="wire-title wire-title-lg">Have a development challenge that may need AI, data or digital support?</h2>
        <p class="wire-sub">Share the problem, users, country or team context, available data and timeline so the Lab can route the request.</p>
        <div class="wire-actions">
          <a href={withBase('/contact')} data-analytics-event="cta_click" data-analytics-category="homepage" data-analytics-label="Final request support" class="wire-btn wire-btn-solid">Request support</a>
          <a href={withBase('/projects')} class="wire-btn">Browse portfolio</a>
        </div>
      </section>
  </main>
</BaseLayout>

<style>
  :root {
    --lab-bg: #050a1a;
    --lab-bg-soft: #081126;
    --lab-bg-panel: #101936;
    --lab-bg-panel-strong: #142248;
    --lab-border: rgba(255, 255, 255, 0.1);
    --lab-border-strong: rgba(124, 199, 255, 0.32);
    --lab-text: #f8fbff;
    --lab-muted: #96a4c4;
    --lab-muted-strong: #cbd6ee;
    --lab-blue: #2f8cff;
    --lab-cyan: #12aeea;
  }

  .wire-home {
    background: var(--lab-bg);
    color: var(--lab-text);
  }

  .wire-sec {
    position: relative;
    padding: 76px max(28px, calc((100vw - 1120px) / 2 + 28px));
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    background: var(--lab-bg-soft);
  }

  .wire-sec:last-child {
    border-bottom: 0;
  }

  .wire-alt {
    background: #070d20;
  }

  .wire-hero {
    min-height: 0;
    padding: 0;
    border-bottom: 0;
    background: transparent;
  }

  .wire-hero .wire-row {
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
  }

  .wire-hero .wire-col-copy {
    flex: 1 1 620px;
  }

  .wire-hero .wire-col:not(.wire-col-copy) {
    flex: 0 1 380px;
  }

  .wire-row {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
  }

  .wire-col {
    min-width: 0;
    flex: 1 1 300px;
  }

  .wire-col-copy {
    flex-basis: 500px;
  }

  .wire-section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 28px;
  }

  .wire-eyebrow {
    margin: 0 0 10px;
    color: #7dbdff;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  .wire-title {
    margin: 0 0 12px;
    color: var(--lab-text);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.06;
  }

  .wire-title-xl {
    max-width: 860px;
    font-size: clamp(3rem, 6.4vw, 5.4rem);
  }

  .wire-title-accent {
    display: block;
    color: #84c8ff;
  }

  .wire-title-lg {
    max-width: 820px;
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .wire-title-md {
    font-size: 1.25rem;
  }

  .wire-sub {
    max-width: 68ch;
    color: var(--lab-muted);
    font-size: 0.98rem;
    line-height: 1.75;
  }

  .wire-sub-lg {
    margin-top: 18px;
    max-width: 680px;
    color: #c9d6f4;
    font-size: 1.08rem;
  }

  .wire-mini {
    margin-top: 14px;
    max-width: 720px;
    color: #8d9ec5;
    font-size: 0.84rem;
  }

  .wire-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 26px;
  }

  .wire-btn,
  .wire-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.04);
    padding: 10px 18px;
    color: #eaf3ff;
    font-size: 0.84rem;
    font-weight: 800;
    text-decoration: none;
    transition: transform .16s ease, background .16s ease, border-color .16s ease, color .16s ease;
  }

  .wire-btn:focus-visible,
  .wire-link:focus-visible {
    outline: 3px solid #7cc7ff;
    outline-offset: 3px;
  }

  /* keep a Tailwind accessibility marker for source-level tests: focus-visible:ring-2 */
  .wire-btn:hover,
  .wire-link:hover {
    border-color: rgba(124, 199, 255, 0.7);
    background: rgba(124, 199, 255, 0.12);
    color: #fff;
    transform: translateY(-1px);
  }

  .wire-btn-solid {
    border-color: transparent;
    background: linear-gradient(135deg, var(--lab-blue), var(--lab-cyan));
    color: #fff;
    box-shadow: 0 16px 36px rgba(18, 174, 234, 0.22);
  }

  .wire-media {
    display: flex;
    min-height: 132px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border: 1px solid var(--lab-border);
    border-radius: 14px;
    background:
      radial-gradient(circle at 20% 20%, rgba(47, 140, 255, 0.24), transparent 34%),
      linear-gradient(145deg, rgba(23, 37, 78, 0.95), rgba(10, 17, 38, 0.95));
    color: #7dbdff;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: .14em;
    text-align: center;
    text-transform: uppercase;
  }

  .wire-media-hero {
    min-height: 380px;
    padding: 32px;
    border-color: rgba(124, 199, 255, 0.22);
    background:
      radial-gradient(circle at 50% 35%, rgba(18, 174, 234, 0.2), transparent 42%),
      linear-gradient(145deg, rgba(13, 31, 67, 0.74), rgba(6, 13, 31, 0.76));
    box-shadow: 0 28px 80px rgba(0, 0, 0, 0.32);
  }

  .wire-media-photo {
    min-height: 220px;
  }

  .wire-grid {
    display: grid;
    gap: 18px;
  }

  .wire-grid-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .wire-grid-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .wire-card {
    min-width: 0;
    border: 1px solid var(--lab-border);
    border-radius: 14px;
    background: linear-gradient(180deg, rgba(20, 31, 65, 0.96), rgba(14, 22, 47, 0.96));
    padding: 18px;
    box-shadow: 0 16px 42px rgba(0, 0, 0, 0.16);
  }

  .wire-card:hover {
    border-color: var(--lab-border-strong);
  }

  .wire-card .wire-media + .wire-title {
    margin-top: 18px;
  }

  .wire-card-compact {
    padding: 22px;
  }

  .wire-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 16px;
  }

  .wire-tag {
    display: inline-flex;
    border: 1px solid rgba(124, 199, 255, 0.22);
    border-radius: 999px;
    background: rgba(124, 199, 255, 0.08);
    padding: 5px 10px;
    color: #b9dcff;
    font-size: 0.7rem;
    font-weight: 800;
  }

  .wire-map {
    margin-top: 24px;
    border: 1px solid var(--lab-border);
    border-radius: 18px;
    background:
      radial-gradient(circle at 18% 28%, rgba(18, 174, 234, 0.18), transparent 30%),
      radial-gradient(circle at 80% 32%, rgba(47, 140, 255, 0.16), transparent 26%),
      linear-gradient(145deg, #111b38, #091126);
    padding: 28px;
  }

  .wire-map-label {
    color: #7dbdff;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: .14em;
    text-align: center;
    text-transform: uppercase;
  }

  .wire-country-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin-top: 24px;
  }

  .wire-country-grid span {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.05);
    padding: 12px 14px;
    color: #e1ecff;
    font-size: 0.84rem;
    font-weight: 800;
    text-align: center;
  }

  .wire-affiliation {
    display: grid;
    grid-template-columns: 0.32fr 1fr;
    gap: 24px;
    border: 1px solid var(--lab-border);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.035);
    padding: 26px;
    color: var(--lab-muted-strong);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.7;
  }

  .wire-case-study {
    align-items: center;
  }

  .wire-convert {
    background: linear-gradient(135deg, #0a97d9, #18b7eb);
  }

  .wire-convert .wire-eyebrow,
  .wire-convert .wire-sub {
    color: rgba(255, 255, 255, 0.84);
  }

  .wire-convert .wire-title {
    color: #fff;
  }

  .wire-convert .wire-btn {
    border-color: rgba(255, 255, 255, 0.55);
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
  }

  .wire-convert .wire-btn-solid {
    border-color: #fff;
    background: #fff;
    color: #0b3f70;
    box-shadow: none;
  }

  @media (max-width: 980px) {
    .wire-grid-3,
    .wire-country-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 820px) {
    .wire-sec {
      padding: 56px 22px;
    }

    .wire-hero .wire-col-copy,
    .wire-hero .wire-col:not(.wire-col-copy) {
      flex-basis: 100%;
    }

    .wire-title-xl {
      font-size: clamp(2.55rem, 12vw, 4rem);
    }

    .wire-media-hero {
      min-height: 280px;
    }

    .wire-grid-2,
    .wire-grid-3,
    .wire-country-grid,
    .wire-affiliation {
      grid-template-columns: 1fr;
    }

    .wire-section-head {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
