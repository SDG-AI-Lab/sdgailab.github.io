---
import { withBase } from '../lib/url';
import BaseLayout from '../components/layout/BaseLayout.astro';
import FeaturedProjects from '../islands/FeaturedProjects';
import PartnerLogos from '../islands/PartnerLogos';
import GeographicReach from '../islands/GeographicReach';
import LatestActivity from '../islands/LatestActivity';
import { impactAreas } from '../data/sampleContent';

const areaIcons = ['01', '02', '03', '04', '05', '06'];

const credibilityMetrics = [
  {
    label: 'Years of experience',
    value: '7',
  },
  {
    label: 'Projects in the portfolio',
    value: '50+',
  },
  {
    label: 'Countries reached',
    value: '25+',
  },
  {
    label: 'Knowledge products',
    value: '15+',
  },
];
---

<BaseLayout
  title="SDG AI Lab | Practical AI and data solutions for development"
  description="A UNDP initiative helping country offices, governments and partners turn development challenges into practical, reusable AI and data solutions."
>
  <main class="landing-home bg-lab-base text-lab-text">
    <section
      class="landing-hero relative grid min-h-[560px] place-items-center overflow-hidden border-b border-lab-accent/20 bg-[radial-gradient(ellipse_at_50%_18%,rgba(76,141,255,0.26)_0%,rgba(76,141,255,0.10)_32%,rgba(34,36,42,0)_66%),linear-gradient(180deg,#2B2E36_0%,#22242A_72%,#22242A_100%)] max-[620px]:min-h-[520px]"
      aria-labelledby="hero-heading"
    >
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <span
          class="absolute left-[-40px] top-[54px] h-40 w-40 rotate-[20deg] border border-lab-accent/20 opacity-75 [clip-path:polygon(16%_0,100%_28%,82%_88%,18%_100%,0_40%)]"
        ></span>
        <span
          class="absolute right-[-54px] top-[-40px] h-[190px] w-[190px] rotate-[20deg] border border-lab-accent/20 opacity-75 [clip-path:polygon(28%_0,100%_10%,80%_80%,10%_100%,0_24%)]"
        ></span>
        <span
          class="absolute left-[11%] top-[55%] h-2.5 w-2.5 rounded-full bg-lab-accent opacity-55 shadow-[0_0_18px_rgba(36,107,254,0.42)] motion-safe:animate-landing-float"
        ></span>
        <span
          class="absolute left-[25%] top-[77%] h-2.5 w-2.5 rounded-full bg-lab-accent opacity-55 shadow-[0_0_18px_rgba(36,107,254,0.42)] motion-safe:animate-landing-float [animation-delay:-2s]"
        ></span>
        <span
          class="absolute right-[17%] top-[45%] h-2.5 w-2.5 rounded-full bg-lab-accent opacity-55 shadow-[0_0_18px_rgba(36,107,254,0.42)] motion-safe:animate-landing-float [animation-delay:-4s]"
        ></span>
        <span
          class="absolute right-[8%] top-[63%] h-2.5 w-2.5 rounded-full bg-lab-accent opacity-55 shadow-[0_0_18px_rgba(36,107,254,0.42)] motion-safe:animate-landing-float [animation-delay:-6s]"
        ></span>
      </div>

      <div
        class="relative z-10 mx-auto grid w-[min(100%-2rem,1120px)] max-w-[940px] justify-items-center px-4 py-[92px] pb-[110px] text-center"
      >
        <h1
          id="hero-heading"
          class="max-w-[850px] text-[clamp(2.55rem,5.6vw,5rem)] font-black leading-[0.98] tracking-[-0.055em] text-lab-text max-[620px]:text-[clamp(2.35rem,14vw,3.4rem)]"
        >
          We help UNDP teams turn complex challenges into AI solutions.
        </h1>
        <p
          class="mt-7 max-w-[730px] text-[clamp(1rem,1.25vw,1.15rem)] font-semibold leading-7 text-lab-muted"
        >
          Identifying where AI can create meaningful value&mdash;drawing on
          development expertise, responsible AI principles, and global
          partnerships.
        </p>
        <div
          class="mt-[34px] flex flex-wrap justify-center gap-4 max-[620px]:w-full"
          aria-label="Homepage actions"
        >
          <a
            href={withBase('/contact')}
            data-analytics-event="cta_click"
            data-analytics-category="homepage"
            data-analytics-label="Hero request support"
            class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-lab-accent px-6 py-3 text-sm font-extrabold text-lab-text no-underline shadow-[0_14px_30px_rgba(76,141,255,0.24)] transition hover:-translate-y-0.5 hover:bg-primary-dark focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-lab-accent/40 max-[620px]:w-full"
          >
            Request support <span aria-hidden="true">&rarr;</span>
          </a>
          <a
            href={withBase('/projects')}
            class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-lab-surface px-6 py-3 text-sm font-extrabold text-lab-text no-underline shadow-[0_12px_26px_rgba(16,29,53,0.1)] transition hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-lab-accent/40 max-[620px]:w-full"
          >
            Explore projects
          </a>
        </div>
      </div>
    </section>

    <section
      class="bg-lab-base py-[clamp(70px,8vw,112px)]"
      aria-labelledby="track-record-heading"
    >
      <div class="mx-auto w-[min(100%-2rem,1120px)]">
        <div class="grid gap-10 lg:grid-cols-[0.82fr_1.18fr] lg:items-start">
          <div>
            <h2
              id="track-record-heading"
              class="mt-4 max-w-[620px] text-[clamp(2rem,3.6vw,3.35rem)] font-black leading-[1.04] tracking-[-0.05em] text-lab-text"
            >
              A proven record in AI for development.
            </h2>
            <p
              class="mt-5 max-w-[640px] text-justify text-base font-semibold leading-7 text-lab-muted"
            >
              Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do
              eiusmod tempor incididunt ut labore et dolore magna aliqua.
            </p>

            <div
              class="mt-8 grid gap-x-8 gap-y-7 sm:grid-cols-2"
              aria-label="SDG AI Lab track record indicators"
            >
              {
                credibilityMetrics.map((metric) => (
                  <article>
                    <strong class="block text-[clamp(2.35rem,5vw,4.25rem)] font-black leading-none tracking-[-0.055em] text-lab-text">
                      {metric.value}
                    </strong>
                    <p class="mt-3 text-sm font-black uppercase tracking-[0.13em] text-lab-accent-soft">
                      {metric.label}
                    </p>
                  </article>
                ))
              }
            </div>

            <div class="mt-8 flex flex-wrap gap-3">
              <a
                href={withBase('/projects')}
                class="inline-flex min-h-11 items-center justify-center rounded-full bg-lab-accent px-5 py-3 text-sm font-extrabold text-lab-text no-underline shadow-[0_14px_30px_rgba(76,141,255,0.24)] transition hover:-translate-y-0.5 hover:bg-primary-dark"
              >
                Explore projects <span aria-hidden="true" class="ml-2"
                  >&rarr;</span
                >
              </a>
              <a
                href={withBase('/resources')}
                class="inline-flex min-h-11 items-center justify-center rounded-full bg-lab-surface px-5 py-3 text-sm font-extrabold text-lab-text no-underline ring-1 ring-lab-border/70 transition hover:-translate-y-0.5 hover:ring-lab-accent/50"
              >
                Browse publications
              </a>
            </div>
          </div>

          <div class="lg:pt-2">
            <h3 id="geographic-reach-heading" class="sr-only">
              Implementation countries in view.
            </h3>
            <GeographicReach client:load />
          </div>
        </div>
      </div>
    </section>
    <section
      class="bg-lab-base py-[clamp(70px,8vw,112px)]"
      aria-labelledby="expertise-heading"
    >
      <div class="mx-auto w-[min(100%-2rem,1120px)]">
        <div class="mb-11 max-w-[760px]">
          <h2
            id="expertise-heading"
            class="m-0 text-[clamp(2rem,3.2vw,3.05rem)] font-black leading-[1.08] tracking-[-0.04em] text-lab-text"
          >
            Our core areas of expertise
          </h2>
          <p class="mt-3.5 text-base font-semibold leading-7 text-lab-muted">
            We focus on six key domains where we bring the greatest experience,
            proven methodologies, and practical AI solutions.
          </p>
        </div>

        <div
          class="mt-[58px] grid grid-cols-2 gap-x-[82px] gap-y-11 max-[900px]:grid-cols-1"
        >
          {
            impactAreas.map((area, index) => (
              <article class="grid grid-cols-[auto_1fr] gap-[18px]">
                <span
                  class="grid h-[30px] w-[30px] place-items-center text-lg font-black leading-none text-lab-accent-soft"
                  aria-hidden="true"
                >
                  {areaIcons[index]}
                </span>
                <div>
                  <h3 class="m-0 text-lg font-black text-lab-text">
                    {area.title}
                  </h3>
                  <p class="mt-2.5 text-sm font-semibold leading-7 text-lab-muted">
                    {area.summary}
                  </p>
                </div>
              </article>
            ))
          }
        </div>

        <!-- <div
          class="mt-[74px] flex items-center justify-between gap-6 rounded-xl border border-lab-border bg-lab-section px-[clamp(24px,5vw,54px)] py-7 max-[900px]:flex-col max-[900px]:items-start"
        >
          <div>
            <p
              class="mb-2 text-xs font-black uppercase tracking-[0.12em] text-lab-accent-soft"
            >
              Work with us
            </p>
            <h2
              class="m-0 text-[clamp(1.25rem,2.2vw,1.75rem)] font-black tracking-[-0.02em] text-lab-text"
            >
              Have a development challenge to explore?
            </h2>
          </div>
          <a
            href={withBase('/contact')}
            class="inline-flex min-h-11 items-center justify-center gap-2 rounded-full bg-lab-accent px-5 py-3 text-sm font-extrabold text-lab-text no-underline shadow-[0_14px_30px_rgba(76,141,255,0.24)] transition hover:-translate-y-0.5 hover:bg-primary-dark focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-lab-accent/40"
          >
            Start a conversation <span aria-hidden="true">&rarr;</span>
          </a>
        </div> -->
      </div>
    </section>

    <section
      class="bg-lab-surface py-[clamp(70px,8vw,112px)]"
      aria-labelledby="portfolio-heading"
    >
      <div class="mx-auto w-[min(100%-2rem,1120px)]">
        <div class="mb-10 max-w-[760px]">
          <!-- <span
            class="mb-3.5 inline-flex rounded-full bg-lab-surface px-3 py-1.5 text-xs font-black uppercase tracking-[0.12em] text-lab-accent-soft"
          >
            Portfolio
          </span> -->
          <h2
            id="portfolio-heading"
            class="m-0 text-[clamp(2rem,3.2vw,3.05rem)] font-black leading-[1.08] tracking-[-0.04em] text-lab-text"
          >
            Explore our project portfolio
          </h2>
          <p class="mt-3.5 text-base font-semibold leading-7 text-lab-muted">
            Browse real-world AI projects, practical approaches, and reusable
            solutions developed with UNDP teams and partners.
          </p>
        </div>
        <FeaturedProjects client:load limit={3} />
        <div class="mt-[46px] flex justify-center">
          <a
            href={withBase('/projects')}
            class="inline-flex min-h-11 items-center justify-center gap-2 rounded-full bg-lab-accent px-5 py-3 text-sm font-extrabold text-lab-text no-underline shadow-[0_14px_30px_rgba(76,141,255,0.24)] transition hover:-translate-y-0.5 hover:bg-primary-dark focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-lab-accent/40"
          >
            View all projects <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <section
      class="bg-lab-base py-[clamp(70px,8vw,112px)]"
      aria-labelledby="latest-activity-heading"
    >
      <div class="mx-auto w-[min(100%-2rem,1120px)]">
        <div class="mb-10 max-w-[760px]">
          <h2
            id="latest-activity-heading"
            class="m-0 text-[clamp(2rem,3.2vw,3.05rem)] font-black leading-[1.08] tracking-[-0.04em] text-lab-text"
          >
            Discover the Lab's work and knowledge.
          </h2>
          <p class="mt-3.5 text-justify text-base font-semibold leading-7 text-lab-muted">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
          </p>
        </div>
        <LatestActivity client:load />
      </div>
    </section>
    <section
      class="bg-lab-surface pb-[clamp(70px,8vw,112px)] pt-[18px]"
      aria-labelledby="partners-heading"
    >
      <div class="mx-auto w-[min(100%-2rem,1120px)]">
        <div class="mb-10">
          <h2
            id="partners-heading"
            class="m-0 text-[clamp(2rem,3.2vw,3.05rem)] font-black leading-[1.08] tracking-[-0.04em] text-lab-text"
          >
            Our Partners
          </h2>
        </div>
        <PartnerLogos client:load variant="marquee" />

        <div
          class="mt-[54px] flex items-center justify-between gap-6 rounded-xl border border-lab-border bg-lab-section px-[clamp(24px,5vw,54px)] py-7 max-[900px]:flex-col max-[900px]:items-start"
        >
          <div>
            <p
              class="mb-2 text-xs font-black uppercase tracking-[0.12em] text-lab-accent-soft"
            >
              Work with us
            </p>
            <h2
              class="m-0 text-[clamp(1.25rem,2.2vw,1.75rem)] font-black tracking-[-0.02em] text-lab-text"
            >
              Have a development challenge to explore?
            </h2>
          </div>
          <a
            href={withBase('/contact')}
            class="inline-flex min-h-11 items-center justify-center gap-2 rounded-full bg-lab-accent px-5 py-3 text-sm font-extrabold text-lab-text no-underline shadow-[0_14px_30px_rgba(76,141,255,0.24)] transition hover:-translate-y-0.5 hover:bg-primary-dark focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-lab-accent/40"
          >
            Start a conversation <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>










