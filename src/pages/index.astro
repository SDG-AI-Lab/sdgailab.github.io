---
import { withBase } from '../lib/url';
import BaseLayout from '../components/layout/BaseLayout.astro';
import ParticlesHero from '../components/sections/ParticlesHero.astro';
import SDGWheel from '../components/ui/SDGWheel.astro';
import StatsCards from '../islands/StatsCards';
import FeaturedProjects from '../islands/FeaturedProjects';
import PartnerLogos from '../islands/PartnerLogos';
import NewsList from '../islands/NewsList';
import { impactAreas, labServiceLines } from '../data/sampleContent';
---

<BaseLayout
  title="SDG AI Lab | Artificial Intelligence for Sustainable Development"
  description="A UNDP initiative helping development teams frame problems, prototype responsible AI and data solutions, and share reusable learning."
>
  <ParticlesHero>
    <div class="grid items-center gap-12 lg:grid-cols-[1.25fr_.75fr] lg:gap-16">
      <div class="max-w-3xl">
        <p class="mb-5 text-sm font-bold uppercase tracking-[0.2em] text-blue-200">A UNDP initiative</p>
        <h1 class="max-w-3xl text-4xl font-bold leading-[1.08] text-white sm:text-5xl lg:text-7xl">
          Artificial Intelligence for <span class="text-blue-200">Sustainable Development</span>
        </h1>
        <p class="mt-7 max-w-2xl text-lg leading-8 text-blue-50 sm:text-xl">
          We bring together development expertise, responsible AI and global partnerships to turn complex challenges into practical, reusable solutions.
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a href={withBase('/contact')} data-analytics-event="cta_click" data-analytics-category="homepage" data-analytics-label="Hero request technical support" class="inline-flex min-h-12 items-center justify-center rounded-md bg-white px-6 py-3 text-sm font-bold text-primary shadow-lg transition hover:bg-blue-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-primary">
            Request technical support <span class="ml-2" aria-hidden="true">&rarr;</span>
          </a>
          <a href={withBase('/projects')} data-analytics-event="cta_click" data-analytics-category="homepage" data-analytics-label="Hero explore solutions and projects" class="inline-flex min-h-12 items-center justify-center rounded-md border border-white/50 bg-white/5 px-6 py-3 text-sm font-bold text-white transition hover:bg-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-white">
            Explore solutions and projects
          </a>
        </div>
        <p class="mt-5 max-w-2xl text-sm leading-6 text-blue-100">
          Support areas include AI prototyping, GIS and remote sensing, NLP and knowledge tools, digital public finance, resilience, research and advisory work.
        </p>
      </div>

      <div class="relative mx-auto w-full max-w-sm" aria-label="SDG AI Lab work cycle visual">
        <div class="rounded-2xl border border-white/20 bg-primary-900/60 p-7 shadow-2xl backdrop-blur-sm sm:p-9">
          <SDGWheel class="mx-auto h-56 w-56 sm:h-64 sm:w-64" />
          <div class="mt-7 grid grid-cols-3 gap-3 border-t border-white/15 pt-6 text-center">
            <div><strong class="block text-2xl text-white">6</strong><span class="text-xs text-blue-200">Impact areas</span></div>
            <div><strong class="block text-2xl text-white">5</strong><span class="text-xs text-blue-200">Service lines</span></div>
            <div><strong class="block text-2xl text-white">AI</strong><span class="text-xs text-blue-200">Responsibly applied</span></div>
          </div>
        </div>
      </div>
    </div>
  </ParticlesHero>

  <section class="border-b border-slate-200 bg-white py-7" aria-label="Focus areas">
    <div class="container-narrow grid gap-4 text-sm font-semibold text-slate-700 sm:grid-cols-3 sm:gap-0">
      <p class="flex items-center gap-3 sm:border-r sm:border-slate-200 sm:pr-6"><span class="h-2.5 w-2.5 rounded-full bg-[#26BDE2]"></span>Problem framing and data readiness</p>
      <p class="flex items-center gap-3 sm:px-6"><span class="h-2.5 w-2.5 rounded-full bg-[#4C9F38]"></span>Responsible prototypes and tools</p>
      <p class="flex items-center gap-3 sm:border-l sm:border-slate-200 sm:pl-6"><span class="h-2.5 w-2.5 rounded-full bg-[#FD6925]"></span>Evidence, learning and reuse</p>
    </div>
  </section>

  <section class="section-padding bg-white" aria-labelledby="mission-heading">
    <div class="container-narrow grid gap-12 lg:grid-cols-[.8fr_1.2fr] lg:gap-20">
      <div>
        <p class="section-label">What we do</p>
        <h2 id="mission-heading" class="mt-3 text-3xl font-bold text-slate-950 sm:text-4xl">Development challenges first. Technology in service of impact.</h2>
      </div>
      <div>
        <p class="text-lg leading-8 text-slate-600">SDG AI Lab works across the full journey from problem framing and data readiness to prototyping, evaluation and knowledge sharing. We help UNDP teams and partners explore where AI can add value—and where it should not be used.</p>
        <div class="mt-9 grid gap-7 sm:grid-cols-3">
          <article><span class="text-sm font-bold text-primary">01</span><h3 class="mt-2 text-lg font-bold text-slate-950">Research</h3><p class="mt-2 text-sm leading-6 text-slate-600">Investigate needs, evidence, data and responsible methods.</p></article>
          <article><span class="text-sm font-bold text-primary">02</span><h3 class="mt-2 text-lg font-bold text-slate-950">Build</h3><p class="mt-2 text-sm leading-6 text-slate-600">Co-design prototypes with the people who will use them.</p></article>
          <article><span class="text-sm font-bold text-primary">03</span><h3 class="mt-2 text-lg font-bold text-slate-950">Share</h3><p class="mt-2 text-sm leading-6 text-slate-600">Publish reusable methods, tools and lessons for the ecosystem.</p></article>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding bg-slate-50" aria-labelledby="offer-heading">
    <div class="container-narrow">
      <div class="mb-10 max-w-3xl">
        <p class="section-label">Service offer</p>
        <h2 id="offer-heading" class="mt-3 text-3xl font-bold text-slate-950 sm:text-4xl">
          Practical AI support for development teams
        </h2>
        <p class="mt-4 text-lg leading-8 text-slate-600">
          The lab helps teams move from early questions to responsible, testable solutions. Support can be adapted to advisory, prototype, research or capacity-building needs.
        </p>
      </div>

      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {labServiceLines.map(({ title, body }, index) => (
          <article class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
            <span class="text-sm font-bold text-primary">{String(index + 1).padStart(2, '0')}</span>
            <h3 class="mt-3 text-lg font-bold text-slate-950">{title}</h3>
            <p class="mt-3 text-sm leading-6 text-slate-600">{body}</p>
          </article>
        ))}
      </div>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={withBase('/contact')} data-analytics-event="cta_click" data-analytics-category="homepage" data-analytics-label="Service request support" class="inline-flex min-h-12 items-center justify-center rounded-md bg-primary px-6 py-3 text-sm font-bold text-white shadow transition hover:bg-primary-dark">
          Request support
        </a>
        <a href={withBase('/resources')} data-analytics-event="cta_click" data-analytics-category="homepage" data-analytics-label="Service explore resources" class="inline-flex min-h-12 items-center justify-center rounded-md border border-slate-300 px-6 py-3 text-sm font-bold text-slate-700 transition hover:border-primary hover:text-primary">
          Explore resources
        </a>
      </div>
    </div>
  </section>

  <section class="section-padding bg-white" aria-labelledby="impact-areas-heading">
    <div class="container-narrow">
      <div class="mb-10 max-w-3xl">
        <p class="section-label">Impact areas</p>
        <h2 id="impact-areas-heading" class="mt-3 text-3xl font-bold text-slate-950 sm:text-4xl">
          Delivering solutions across key domains
        </h2>
        <p class="mt-4 text-lg leading-8 text-slate-600">
          The Lab's work is grouped into six areas that make the portfolio easier to understand, benchmark and expand.
        </p>
      </div>

      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {impactAreas.map((area) => (
          <article class="rounded-xl border border-slate-200 bg-slate-50 p-6">
            <div class="flex items-center justify-between gap-4">
              <h3 class="text-lg font-bold text-slate-950">{area.title}</h3>
              {/* <span class="shrink-0 rounded-full bg-white px-3 py-1 text-xs font-bold text-primary shadow-sm">{area.timeline}</span> */}
            </div>
            <p class="mt-3 text-sm leading-6 text-slate-600">{area.summary}</p>
            <ul class="mt-4 space-y-1 text-sm text-slate-700">
              {area.examples.slice(0, 3).map((item) => <li>• {item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding bg-slate-50" aria-labelledby="stats-heading">
    <div class="container-narrow">
      <div class="mb-9 max-w-2xl">
        <p class="section-label">Our ecosystem</p>
        <h2 id="stats-heading" class="mt-3 text-3xl font-bold text-slate-950 sm:text-4xl">Building capacity through collaboration</h2>
      </div>
      <StatsCards client:load />
      <div class="mt-8 grid gap-5 rounded-xl border border-slate-200 bg-white p-6 shadow-sm md:grid-cols-3">
        <article>
          <h3 class="text-base font-bold text-slate-950">Evidence over activity</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">Impact figures should link back to projects, outputs or verified team records before production.</p>
        </article>
        <article>
          <h3 class="text-base font-bold text-slate-950">Portfolio learning</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">Case studies should capture what worked, what did not and what can be reused by other teams.</p>
        </article>
        <article>
          <h3 class="text-base font-bold text-slate-950">Responsible results</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">Published outcomes should include safeguards, limitations and human oversight where AI is used.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section-padding bg-white" aria-labelledby="featured-heading">
    <div class="container-narrow">
      <div class="mb-10 flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
        <div class="max-w-2xl">
          <p class="section-label">Selected work</p>
          <h2 id="featured-heading" class="mt-3 text-3xl font-bold text-slate-950 sm:text-4xl">Projects designed for real-world use</h2>
          <p class="mt-4 leading-7 text-slate-600">Explore how the lab approaches development challenges, methods, datasets, outcomes and reusable resources.</p>
        </div>
        <a href={withBase('/projects')} class="shrink-0 text-sm font-bold text-primary hover:underline">View all projects <span aria-hidden="true">→</span></a>
      </div>
      <FeaturedProjects client:load />
    </div>
  </section>

  <section class="section-padding bg-primary-900 text-white" aria-labelledby="principles-heading">
    <div class="container-narrow">
      <div class="mb-10 max-w-3xl">
        <p class="text-sm font-bold uppercase tracking-[0.18em] text-blue-300">How we work</p>
        <h2 id="principles-heading" class="mt-3 text-3xl font-bold sm:text-4xl">Agile software development, aligned with UNDP best practices and enhanced by AI</h2>
        <p class="mt-5 text-sm leading-7 text-blue-100">
          The Lab works through structured discovery, planning, implementation and delivery cycles, with bi-weekly sprints at the center of the process.
        </p>
      </div>

      <div class="rounded-2xl border border-white/15 bg-black/20 p-5 shadow-2xl sm:p-7">
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-6">
          {[
            ['01', 'Business Understanding', 'Clarify the challenge and expected value.'],
            ['02', 'Team Building', 'Bring together domain, data and delivery expertise.'],
            ['03', 'Product Planning', 'Define scope, backlog and priorities.'],
            ['04', 'Bi-weekly Sprints', 'Plan, build, review and adjust in focused cycles.'],
            ['05', 'Implementation', 'Build, test and refine the solution.'],
            ['06', 'Delivery', 'Package outputs for handover and reuse.'],
          ].map(([step, title, body]) => (
            <article class:list={[
              'rounded-xl border p-5',
              step === '04' ? 'border-blue-400 bg-blue-500/15 shadow-lg shadow-blue-950/20' : 'border-white/15 bg-white/5',
            ]}>
              <span class="text-xs font-bold text-blue-300">{step}</span>
              <h3 class="mt-3 text-base font-bold text-white">{title}</h3>
              <p class="mt-3 text-sm leading-6 text-blue-100">{body}</p>
            </article>
          ))}
        </div>

        <div class="mt-6 grid gap-3 sm:grid-cols-3">
          <div class="rounded-xl border border-emerald-400/40 bg-emerald-500/10 px-4 py-3 text-center">
            <h3 class="text-sm font-bold text-white">Sprint Planning</h3>
          </div>
          <div class="rounded-xl border border-blue-400/50 bg-blue-500/15 px-4 py-3 text-center">
            <h3 class="text-sm font-bold text-white">Bi-weekly sprint cycle</h3>
          </div>
          <div class="rounded-xl border border-emerald-400/40 bg-emerald-500/10 px-4 py-3 text-center">
            <h3 class="text-sm font-bold text-white">Review</h3>
          </div>
        </div>

        <div class="mt-4 rounded-xl border border-white/15 bg-white/5 px-4 py-3 text-center text-sm font-bold text-blue-100">
          Continuous Integration & Deployment
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding bg-slate-50" aria-labelledby="insights-heading">
    <div class="container-narrow">
      <div class="mb-9 flex items-end justify-between gap-6">
        <div><p class="section-label">News & publications</p><h2 id="insights-heading" class="mt-3 text-3xl font-bold text-slate-950 sm:text-4xl">Latest thinking from the lab</h2></div>
        <a href={withBase('/news')} class="hidden text-sm font-bold text-primary hover:underline sm:block">Visit newsroom →</a>
      </div>
      <NewsList client:load />
    </div>
  </section>

  <section class="section-padding bg-white" aria-labelledby="resources-heading">
    <div class="container-narrow grid gap-10 lg:grid-cols-[.85fr_1.15fr] lg:items-start">
      <div>
        <p class="section-label">Knowledge products</p>
        <h2 id="resources-heading" class="mt-3 text-3xl font-bold text-slate-950 sm:text-4xl">
          Resources that make the work reusable
        </h2>
        <p class="mt-4 leading-7 text-slate-600">
          Benchmark sites make publications, tools and methods easy to find. This space gives SDG AI Lab a clear home for guidance, toolkits, open-source outputs and research notes.
        </p>
        <a href={withBase('/resources')} data-analytics-event="cta_click" data-analytics-category="homepage" data-analytics-label="Knowledge products view resources" class="mt-6 inline-flex min-h-12 items-center justify-center rounded-md bg-primary px-6 py-3 text-sm font-bold text-white shadow transition hover:bg-primary-dark">
          View resources
        </a>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {[
          ['Publications', 'Research notes, reports and lessons from applied AI work.'],
          ['Toolkits', 'Templates, checklists and practical guidance for project teams.'],
          ['Open-source outputs', 'Approved code, model cards, data statements and repositories.'],
          ['Responsible AI guidance', 'Risk, evaluation, governance and human-oversight resources.'],
        ].map(([title, body]) => (
          <article class="rounded-xl border border-slate-200 bg-slate-50 p-6">
            <h3 class="font-bold text-slate-950">{title}</h3>
            <p class="mt-3 text-sm leading-6 text-slate-600">{body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding bg-white" aria-labelledby="partners-heading">
    <div class="container-narrow">
      <div class="mx-auto mb-9 max-w-2xl text-center"><p class="section-label">Collaboration</p><h2 id="partners-heading" class="mt-3 text-3xl font-bold text-slate-950 sm:text-4xl">Working across the development ecosystem</h2><p class="mt-4 leading-7 text-slate-600">Partnership brings together domain knowledge, data, technical expertise and routes to lasting impact.</p></div>
      <PartnerLogos client:load />
    </div>
  </section>

  <section class="bg-[#0A97D9] py-14 text-white sm:py-16">
    <div class="container-narrow flex flex-col items-start justify-between gap-7 sm:flex-row sm:items-center">
      <div><p class="text-sm font-bold uppercase tracking-[0.18em] text-blue-100">Work with us</p><h2 class="mt-2 text-3xl font-bold">Have a development challenge to explore?</h2></div>
      <a href={withBase('/contact')} data-analytics-event="cta_click" data-analytics-category="homepage" data-analytics-label="Bottom start conversation" class="inline-flex min-h-12 shrink-0 items-center justify-center rounded-md bg-white px-6 py-3 text-sm font-bold text-primary shadow transition hover:bg-blue-50">Start a conversation →</a>
    </div>
  </section>
</BaseLayout>
