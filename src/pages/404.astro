---
import { withBase } from '../lib/url';
import BaseLayout from '../components/layout/BaseLayout.astro';
---

<BaseLayout title="Page Not Found">
  <div class="flex min-h-[60vh] flex-col items-center justify-center px-4 text-center">
    <h1 class="text-8xl font-bold text-primary">404</h1>
    <p class="mt-4 text-xl text-gray-600">Page not found</p>
    <p class="mt-2 text-sm text-gray-500">
      The page you're looking for doesn't exist or has been moved.
    </p>
    <a
      href={withBase('/')}
      class="mt-8 inline-block rounded bg-primary px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-primary-dark"
    >
      Back to Homepage
    </a>
  </div>
</BaseLayout>
