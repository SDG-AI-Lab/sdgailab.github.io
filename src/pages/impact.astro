---
import { withBase } from '../lib/url';
import BaseLayout from '../components/layout/BaseLayout.astro';
import StatsCards from '../islands/StatsCards';

const countries = ['Kazakhstan', 'Guinea', 'Kyrgyzstan', 'Ecuador', 'Fiji', 'Solomon Islands', 'Palau', 'Cook Islands'];
---

<BaseLayout
  title="Impact - SDG AI Lab"
  description="Impact evidence, geographic reach and portfolio learning from SDG AI Lab."
>
  <section class="section-padding bg-white">
    <div class="container-narrow">
      <p class="section-label">Impact</p>
      <h1 class="mt-3 max-w-4xl text-3xl font-bold text-slate-950 sm:text-5xl">Evidence, reach and learning across the portfolio</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600">
        The impact layer turns the Lab's work from a list of activities into evidence visitors can understand: figures, countries, case studies, reusable lessons and the source behind each claim.
      </p>
    </div>
  </section>

  <section class="section-padding bg-slate-50" aria-labelledby="figures-heading">
    <div class="container-narrow">
      <div class="mb-9 max-w-3xl">
        <p class="section-label">Verified figures</p>
        <h2 id="figures-heading" class="mt-3 text-3xl font-bold text-slate-950 sm:text-4xl">Numbers should be sourced, current and tied to records</h2>
        <p class="mt-4 leading-7 text-slate-600">
          Published figures should be traceable to project records, event records, volunteer records or other verified sources.
        </p>
      </div>
      <StatsCards client:load />
    </div>
  </section>

  <section class="section-padding bg-primary-900 text-white" aria-labelledby="map-heading">
    <div class="container-narrow grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.18em] text-blue-300">Geographic layer</p>
        <h2 id="map-heading" class="mt-3 text-3xl font-bold sm:text-4xl">Show where implementation has happened</h2>
        <p class="mt-5 leading-7 text-blue-100">
          A map or country layer helps visitors understand where implementation has happened and where reusable methods have been explored.
        </p>
      </div>
      <div class="rounded-2xl border border-white/15 bg-white/5 p-6">
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {countries.map((country) => (
            <div class="rounded-xl border border-white/15 bg-white/10 px-4 py-3 text-sm font-bold text-white">{country}</div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding bg-white" aria-labelledby="evidence-heading">
    <div class="container-narrow grid gap-8 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <p class="section-label">Evidence model</p>
        <h2 id="evidence-heading" class="mt-3 text-3xl font-bold text-slate-950 sm:text-4xl">Every impact claim should answer four questions</h2>
        <p class="mt-4 leading-7 text-slate-600">
          This gives content owners a review checklist and gives development a stable structure for the final launch version.
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {[
          ['What changed?', 'Outcome, output, decision improvement or capacity change.'],
          ['Where did it happen?', 'Country, partner, institution or implementation setting.'],
          ['How do we know?', 'Source record, project page, report, dashboard or verified metric.'],
          ['What can be reused?', 'Code, method, template, lessons, safeguards or implementation notes.'],
        ].map(([title, body]) => (
          <article class="rounded-xl border border-slate-200 bg-slate-50 p-5">
            <h3 class="font-bold text-slate-950">{title}</h3>
            <p class="mt-3 text-sm leading-6 text-slate-600">{body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding bg-slate-50">
    <div class="container-narrow rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
      <p class="section-label">Related content</p>
      <h2 class="mt-3 text-3xl font-bold text-slate-950">Connect impact back to projects and resources</h2>
      <p class="mt-4 max-w-3xl leading-7 text-slate-600">
        Impact evidence should never stand alone. Visitors should be able to move from a figure to a project, from a project to a solution, and from a solution to resources or technical material.
      </p>
      <div class="mt-7 flex flex-col gap-3 sm:flex-row">
        <a href={withBase('/projects')} class="inline-flex min-h-12 items-center justify-center rounded-md bg-primary px-6 py-3 text-sm font-bold text-white shadow transition hover:bg-primary-dark">View projects</a>
        <a href={withBase('/resources')} class="inline-flex min-h-12 items-center justify-center rounded-md border border-slate-300 px-6 py-3 text-sm font-bold text-slate-700 transition hover:border-primary hover:text-primary">View resources</a>
      </div>
    </div>
  </section>
</BaseLayout>
