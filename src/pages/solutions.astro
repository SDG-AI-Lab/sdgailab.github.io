---
import { withBase } from '../lib/url';
import BaseLayout from '../components/layout/BaseLayout.astro';

const solutions = [
  {
    title: 'Digital Social Vulnerability Index',
    type: 'Geospatial intelligence',
    summary:
      'A reusable approach for combining open data, GIS and machine learning to understand vulnerability patterns and support prioritization.',
    methods: ['Open-data pipeline', 'GIS layers', 'Machine-learning scoring', 'Interactive visualization'],
  },
  {
    title: 'Audit Recommendation Tracking Tool',
    type: 'Institutional workflow',
    summary:
      'A platform pattern for moving audit recommendations from extraction through action plans, evidence, verification and oversight reporting.',
    methods: ['AI-assisted extraction', 'Human review', 'Lifecycle workflow', 'Reporting dashboards'],
  },
  {
    title: 'Public Finance Simplification Platform',
    type: 'Transparency and public finance',
    summary:
      'A product concept for turning public finance documents and datasets into understandable insights, visualizations and reports.',
    methods: ['Document analysis', 'Data visualization', 'Insight generation', 'Public-facing reporting'],
  },
];
---

<BaseLayout
  title="Solutions - SDG AI Lab"
  description="Reusable AI, data and digital solution patterns from SDG AI Lab."
>
  <section class="section-padding bg-white">
    <div class="container-narrow">
      <p class="section-label">Solutions</p>
      <h1 class="mt-3 max-w-4xl text-3xl font-bold text-slate-950 sm:text-5xl">Reusable tools, methods and product patterns</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600">
        Solutions are different from projects. A solution is a reusable tool, platform, model, dashboard or methodology that can be adapted across countries, teams or development contexts.
      </p>

      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        {solutions.map((solution) => (
          <article class="flex h-full flex-col rounded-2xl border border-slate-200 bg-slate-50 p-6 shadow-sm">
            <p class="text-sm font-bold uppercase tracking-wider text-primary">{solution.type}</p>
            <h2 class="mt-3 text-2xl font-bold text-slate-950">{solution.title}</h2>
            <p class="mt-4 flex-1 text-sm leading-6 text-slate-600">{solution.summary}</p>
            <div class="mt-6 rounded-xl border border-dashed border-slate-300 bg-white p-4 text-sm text-slate-500">
              Space for screenshot, architecture diagram, demo embed or short video.
            </div>
            <ul class="mt-5 space-y-2 text-sm text-slate-700">
              {solution.methods.map((method) => (
                <li class="flex gap-2"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary"></span>{method}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding bg-slate-50" aria-labelledby="solution-template-heading">
    <div class="container-narrow grid gap-8 lg:grid-cols-[0.85fr_1.15fr]">
      <div>
        <p class="section-label">Solution page model</p>
        <h2 id="solution-template-heading" class="mt-3 text-3xl font-bold text-slate-950 sm:text-4xl">What every solution page should explain</h2>
        <p class="mt-4 leading-7 text-slate-600">
          Each solution should explain the tool in plain language, show how it works, document safeguards and connect it to related projects and resources.
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {[
          ['Plain-language method', 'A simple explanation of the approach, users and decisions supported.'],
          ['Architecture or workflow', 'A visual showing data inputs, processing, human review and outputs.'],
          ['Responsible AI safeguards', 'Limitations, oversight, validation approach and appropriate-use notes.'],
          ['Related implementation', 'Links to projects, countries, collaborators, resources and media.'],
        ].map(([title, body]) => (
          <article class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
            <h3 class="font-bold text-slate-950">{title}</h3>
            <p class="mt-3 text-sm leading-6 text-slate-600">{body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding bg-primary text-white">
    <div class="container-narrow flex flex-col justify-between gap-6 md:flex-row md:items-center">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.18em] text-blue-100">Need a solution adapted?</p>
        <h2 class="mt-3 text-3xl font-bold">Start with the development problem and context.</h2>
      </div>
      <a href={withBase('/contact')} class="inline-flex min-h-12 items-center justify-center rounded-md bg-white px-6 py-3 text-sm font-bold text-primary shadow transition hover:bg-blue-50">
        Request support
      </a>
    </div>
  </section>
</BaseLayout>
