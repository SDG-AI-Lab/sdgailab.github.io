---
import BaseLayout from '../components/layout/BaseLayout.astro';
---

<BaseLayout title="Contact - SDG AI Lab">
  <section class="section-padding">
    <div class="container-narrow max-w-2xl">
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">Contact Us</h1>
      <p class="text-lg text-gray-600 mb-8">
        Have a question or want to collaborate? Get in touch with the SDG AI Lab team.
      </p>

      <div class="mb-8 grid gap-4 sm:grid-cols-3">
        {[
          ['Request support', 'Bring a development challenge, data question or prototype idea.'],
          ['Partner with us', 'Explore institutional, technical or research collaboration.'],
          ['Contribute expertise', 'Connect as a volunteer, advisor or technical contributor.'],
        ].map(([title, body]) => (
          <article class="rounded-xl border border-slate-200 bg-slate-50 p-5">
            <h2 class="text-base font-bold text-slate-950">{title}</h2>
            <p class="mt-2 text-sm leading-6 text-slate-600">{body}</p>
          </article>
        ))}
      </div>

      <div class="rounded-lg bg-white shadow-md border border-gray-100 p-8">
        <div class="space-y-6">
          <div>
            <h2 class="text-lg font-semibold text-gray-900 mb-2">Email</h2>
            <a
              href="mailto:sdgailab@undp.org"
              class="inline-flex items-center gap-2 text-primary hover:text-primary-dark text-lg font-medium min-h-[44px] min-w-[44px]"
            >
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
              sdgailab@undp.org
            </a>
          </div>

          <div>
            <h2 class="text-lg font-semibold text-gray-900 mb-2">Social Media</h2>
            <div class="flex gap-4">
              <a
                href="https://twitter.com/sdgailab"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-gray-600 hover:text-primary min-h-[44px] min-w-[44px]"
              >
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                </svg>
                @sdgailab
              </a>
              <a
                href="https://github.com/SDG-AI-Lab"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-gray-600 hover:text-primary min-h-[44px] min-w-[44px]"
              >
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
                </svg>
                SDG-AI-Lab
              </a>
            </div>
          </div>

          <div>
            <h2 class="text-lg font-semibold text-gray-900 mb-2">Location</h2>
            <p class="text-gray-600">
              UNDP Istanbul International Centre for Private Sector in Development (IICPSD)<br />
              Istanbul, Turkey
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
