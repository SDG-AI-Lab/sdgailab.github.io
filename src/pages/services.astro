---
import { withBase } from '../lib/url';
import BaseLayout from '../components/layout/BaseLayout.astro';
import { labServiceLines } from '../data/sampleContent';

const serviceSuites = [
  {
    ...labServiceLines[0],
    accent: 'from-lab-accent to-primary-light',
    border: 'border-lab-accent/45',
    text: 'text-lab-accent-soft',
    icon: 'code',
    promise:
      'Design and build practical digital products from prototype to deployment.',
    items: [
      'Custom digital applications',
      'AI/ML prototypes and tools',
      'Interactive dashboards and web platforms',
      'Data pipelines and workflow automation',
      'Deployment, maintenance and handover support',
    ],
  },
  {
    ...labServiceLines[1],
    accent: 'from-lab-accent to-primary-light',
    border: 'border-lab-accent/45',
    text: 'text-lab-accent-soft',
    icon: 'research',
    promise:
      'Turn emerging technology questions into evidence, methods and reusable knowledge that UNDP units and government partners can act on.',
    items: [
      'Frontier technology research',
      'Use-case analysis and feasibility reviews',
      'Datasets, briefs and technical notes',
      'Responsible AI methods and safeguards',
      'Open-source documentation and learning material',
    ],
  },
  {
    ...labServiceLines[2],
    accent: 'from-lab-accent to-primary-light',
    border: 'border-lab-accent/45',
    text: 'text-lab-accent-soft',
    icon: 'advisory',
    promise:
      'Give UNDP units, governments and ministries targeted technical guidance for turning evidence into working, responsible solutions.',
    items: [
      'Technical advisory and architecture review',
      'AI, GIS and data-system guidance',
      'Terms of reference drafting or review',
      'Data readiness and risk assessment',
      'Implementation planning and quality assurance',
    ],
  },
  {
    ...labServiceLines[3],
    accent: 'from-lab-accent to-primary-light',
    border: 'border-lab-accent/45',
    text: 'text-lab-accent-soft',
    icon: 'training',
    promise:
      'Strengthen practical AI, data and digital skills for the people who will own a solution after direct Lab involvement ends.',
    items: [
      'Capacity-building programmes',
      'Hands-on bootcamps and workshops',
      'Mentorship and fellowship support',
      'Learning pathways for government officials, UNDP staff and community volunteers',
      'Volunteer and community learning pathways',
    ],
  },
  {
    ...labServiceLines[4],
    accent: 'from-lab-accent to-primary-light',
    border: 'border-lab-accent/45',
    text: 'text-lab-accent-soft',
    icon: 'network',
    promise:
      "Connect development needs with the right technical partners, institutions and members of the Lab's wider network.",
    items: [
      'Partner mapping and collaboration design',
      'Technology-sector engagement',
      'Joint project scoping and coordination',
      'Clear pathways for teams to reuse, adapt or scale existing Lab work',
      'Pathways for reuse, adoption and scale',
    ],
  },
];

function getServiceId(title: string) {
  if (title === 'Training') return 'training';
  if (title === 'Partnerships') return 'partnership';
  return title.toLowerCase();
}

const requestSteps = [
  ['Context', 'Country, team, institution, users and development challenge.'],
  ['Need', 'The decision, process, service or product that needs support.'],
  [
    'Readiness',
    'Available data, constraints, risks, timeline and existing systems.',
  ],
  [
    'Pathway',
    'Advisory, prototype, research, training, partnership or handover support.',
  ],
];
---

<BaseLayout
  title="Services - SDG AI Lab"
  description="Requestable advisory, prototyping, research, training and collaboration services from SDG AI Lab."
>
  <section class="section-padding bg-lab-base text-lab-text">
    <div class="container-narrow">
      <h1
        class="mt-3 max-w-4xl text-4xl font-extrabold tracking-tight sm:text-5xl"
      >
        Discover Our Services
      </h1>
      <p class="mt-5 max-w-3xl text-justify text-lg leading-8 text-lab-muted">
        SDG AI Lab delivers AI solutions and provides research, advisory,
        training and collaboration support to UNDP units, governments and
        development partners. The Lab builds custom digital solutions from the
        ground up or adapts existing tools to meet specific needs.
      </p>
    </div>
  </section>

  <section
    class="section-padding bg-lab-surface text-lab-text"
    aria-labelledby="suite-heading"
  >
    <div class="container-narrow">
      <!-- <div class="mb-20">
        <div>
          <h2 id="suite-heading" class="mt-3 text-3xl font-bold sm:text-4xl">
            Choose the support pathway that fits the work
          </h2>
        </div>
      </div> -->

      <div class="grid gap-x-7 gap-y-12 md:grid-cols-2 xl:grid-cols-3">
        {
          serviceSuites.map((service, index) => (
            <article
              id={getServiceId(service.title)}
              class={`scroll-mt-28 flex h-full flex-col rounded-3xl border-2 ${service.border} bg-lab-surface text-lab-text shadow-[0_14px_34px_rgba(16,29,53,0.08)]`}
            >
              <div class="relative px-6 pb-5 pt-12 text-center">
                <div
                  class={`absolute left-1/2 top-0 flex h-20 w-20 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-gradient-to-br ${service.accent} shadow-lg shadow-[0_14px_30px_rgba(76,141,255,0.22)]`}
                  aria-hidden="true"
                >
                  {service.icon === 'code' && (
                    <svg
                      class="h-9 w-9 text-white"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path d="m16 18 6-6-6-6" />
                      <path d="m8 6-6 6 6 6" />
                      <path d="m14.5 4-5 16" />
                    </svg>
                  )}
                  {service.icon === 'research' && (
                    <svg
                      class="h-9 w-9 text-white"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <circle cx="11" cy="11" r="7" />
                      <path d="m20 20-3.5-3.5" />
                      <path d="M8 11h6M11 8v6" />
                    </svg>
                  )}
                  {service.icon === 'advisory' && (
                    <svg
                      class="h-9 w-9 text-white"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path d="M12 3 3 8l9 5 9-5-9-5Z" />
                      <path d="M3 14l9 5 9-5" />
                      <path d="M3 11l9 5 9-5" />
                    </svg>
                  )}
                  {service.icon === 'training' && (
                    <svg
                      class="h-9 w-9 text-white"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path d="M22 10 12 5 2 10l10 5 10-5Z" />
                      <path d="M6 12v5c3 2 9 2 12 0v-5" />
                    </svg>
                  )}
                  {service.icon === 'network' && (
                    <svg
                      class="h-9 w-9 text-white"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <circle cx="6" cy="12" r="3" />
                      <circle cx="18" cy="6" r="3" />
                      <circle cx="18" cy="18" r="3" />
                      <path d="m8.6 10.5 6.8-3" />
                      <path d="m8.6 13.5 6.8 3" />
                    </svg>
                  )}
                </div>
                <span class={`text-xs font-extrabold ${service.text}`}>
                  {String(index + 1).padStart(2, '0')}
                </span>
                <h3
                  class={`mt-2 text-xl font-extrabold uppercase leading-tight ${service.text}`}
                >
                  {service.title === 'Training'
                    ? 'Capacity Building'
                    : service.title}
                </h3>
                <p class="mt-4 text-sm font-semibold leading-6 text-lab-muted">
                  {service.promise}
                </p>
              </div>
              <div class="mx-5 mb-5 flex-1 rounded-2xl border border-lab-border bg-lab-section p-5">
                <ul class="space-y-3 text-sm leading-6 text-lab-muted">
                  {service.items.map((item) => (
                    <li class="flex gap-3">
                      <span
                        class={`mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gradient-to-br ${service.accent}`}
                        aria-hidden="true"
                      />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>

      <!-- <div
        class="mt-10 rounded-2xl border border-lab-border bg-lab-section p-6 text-center text-lab-muted"
      >
        Responsible data and AI governance is treated as a layer across all
        services &mdash; from scoping and design to delivery, publication and
        reuse.
      </div> -->
    </div>
  </section>

  <!-- <section
    class="section-padding bg-lab-section"
    aria-labelledby="request-heading"
  >
    <div class="container-narrow grid gap-8 lg:grid-cols-[0.85fr_1.15fr]">
      <div>
        <p class="section-label">How to request support</p>
        <h2
          id="request-heading"
          class="mt-3 text-3xl font-bold text-lab-text sm:text-4xl"
        >
          Start with the problem, users and decision context
        </h2>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {
          requestSteps.map(([title, body]) => (
            <article class="rounded-xl border border-lab-border bg-lab-surface p-5 shadow-sm">
              <h3 class="font-bold text-lab-text">{title}</h3>
              <p class="mt-3 text-sm leading-6 text-lab-muted">{body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section> -->

  <section class="section-padding bg-lab-section text-lab-text">
    <div
      class="container-narrow flex flex-col justify-between gap-6 md:flex-row md:items-center"
    >
      <div>
        <p
          class="text-sm font-bold uppercase tracking-[0.18em] text-lab-accent-soft"
        >
          Ready to scope a request?
        </p>
        <h2 class="mt-3 text-3xl font-bold">
          Send the Lab enough context to route the request.
        </h2>
      </div>
      <a
        href={withBase('/contact')}
        class="inline-flex min-h-12 items-center justify-center rounded-md bg-lab-accent px-6 py-3 text-sm font-bold text-white shadow transition hover:bg-primary-dark"
      >
        Contact the Lab
      </a>
    </div>
  </section>
</BaseLayout>
