---
import { withBase } from '../lib/url';
import BaseLayout from '../components/layout/BaseLayout.astro';
import { labServiceLines } from '../data/sampleContent';
---

<BaseLayout
  title="Services - SDG AI Lab"
  description="Requestable advisory, prototyping, research, training and collaboration services from SDG AI Lab."
>
  <section class="section-padding bg-white">
    <div class="container-narrow">
      <p class="section-label">Services</p>
      <h1 class="mt-3 max-w-4xl text-3xl font-bold text-slate-950 sm:text-5xl">Support pathways for teams exploring AI, data and digital solutions</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600">
        Services explain what can be requested from the Lab. They are distinct from reusable solutions and from individual project implementations.
      </p>

      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {labServiceLines.map(({ title, body }, index) => (
          <article class="rounded-2xl border border-slate-200 bg-slate-50 p-6 shadow-sm">
            <span class="text-sm font-bold text-primary">{String(index + 1).padStart(2, '0')}</span>
            <h2 class="mt-3 text-xl font-bold text-slate-950">{title}</h2>
            <p class="mt-3 text-sm leading-6 text-slate-600">{body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding bg-slate-50" aria-labelledby="request-heading">
    <div class="container-narrow grid gap-8 lg:grid-cols-[0.85fr_1.15fr]">
      <div>
        <p class="section-label">How to request support</p>
        <h2 id="request-heading" class="mt-3 text-3xl font-bold text-slate-950 sm:text-4xl">Start with the problem, users and decision context</h2>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {[
          ['Context', 'Country, team, institution, users and development challenge.'],
          ['Need', 'The decision, process, service or product that needs support.'],
          ['Readiness', 'Available data, constraints, risks, timeline and existing systems.'],
          ['Pathway', 'Advisory, prototype, research, training, partnership or handover support.'],
        ].map(([title, body]) => (
          <article class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
            <h3 class="font-bold text-slate-950">{title}</h3>
            <p class="mt-3 text-sm leading-6 text-slate-600">{body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding bg-primary text-white">
    <div class="container-narrow flex flex-col justify-between gap-6 md:flex-row md:items-center">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.18em] text-blue-100">Ready to scope a request?</p>
        <h2 class="mt-3 text-3xl font-bold">Send the Lab enough context to route the request.</h2>
      </div>
      <a href={withBase('/contact')} class="inline-flex min-h-12 items-center justify-center rounded-md bg-white px-6 py-3 text-sm font-bold text-primary shadow transition hover:bg-blue-50">
        Contact the Lab
      </a>
    </div>
  </section>
</BaseLayout>
