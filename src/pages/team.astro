---
import BaseLayout from '../components/layout/BaseLayout.astro';
---

<BaseLayout
  title="Our Team - SDG AI Lab"
  description="SDG AI Lab team organized across coordination, research, advisory, GIS, GeoAI, software development, NLP, LLM, training and data science groups."
>
  <div class="marina-team-page" id="main">
    <section class="band" id="team">
      <div class="wrap">
        <div class="band-head reveal">
          <span class="eyebrow" data-n="05">Our team</span>
          <h2>Six working groups, one lab.</h2>
        </div>

        <div class="team-group reveal">
          <h3>Coordination · Research &amp; Advisory</h3>
          <div class="team-row">
            <div class="person-card tilt"><div class="person-avatar" aria-hidden="true">GD</div><div class="name">Gokhan Dikmener</div><div class="role">Chief Technology Advisor</div></div>
            <div class="person-card tilt"><div class="person-avatar" aria-hidden="true">DA</div><div class="name">Dina Akyibekova</div><div class="role">Programme Specialist</div></div>
            <div class="person-card tilt"><div class="person-avatar" aria-hidden="true">CO</div><div class="name">Cansu Ozgur</div><div class="role">Programme Analyst</div></div>
            <div class="person-card tilt"><div class="person-avatar" aria-hidden="true">LO</div><div class="name">Luka Ozay</div><div class="role">Research Intern</div></div>
            <div class="person-card tilt"><div class="person-avatar" aria-hidden="true">IB</div><div class="name">Ihsan Bilgin</div><div class="role">Research Intern</div></div>
          </div>
        </div>

        <div class="team-group reveal">
          <h3>GIS &amp; GeoAI · Software Development</h3>
          <div class="team-row">
            <div class="person-card tilt"><div class="person-avatar" aria-hidden="true">AD</div><div class="name">Alper Dincer</div><div class="role">GIS Analyst</div></div>
            <div class="person-card tilt"><div class="person-avatar" aria-hidden="true">SP</div><div class="name">Salsabila Prasetya</div><div class="role">GIS Analyst</div></div>
            <div class="person-card tilt"><div class="person-avatar" aria-hidden="true">AS</div><div class="name">Aykut Sevim</div><div class="role">Software Dev Specialist</div></div>
            <div class="person-card tilt"><div class="person-avatar" aria-hidden="true">JO</div><div class="name">Jackson Onyango</div><div class="role">Full Stack Developer</div></div>
            <div class="person-card tilt"><div class="person-avatar" aria-hidden="true">JU</div><div class="name">Josue Ushindi</div><div class="role">Full Stack Developer</div></div>
          </div>
        </div>

        <div class="team-group reveal">
          <h3>NLP / LLM · Training &amp; Data Science</h3>
          <div class="team-row">
            <div class="person-card tilt"><div class="person-avatar" aria-hidden="true">MS</div><div class="name">Muhammed Suleman</div><div class="role">Data Scientist Fellow</div></div>
            <div class="person-card tilt"><div class="person-avatar" aria-hidden="true">MA</div><div class="name">Mert Atay</div><div class="role">Data Science Analyst</div></div>
            <div class="person-card tilt"><div class="person-avatar" aria-hidden="true">IB</div><div class="name">Ipek Beril Benli</div><div class="role">Programme Analyst</div></div>
            <div class="person-card tilt"><div class="person-avatar" aria-hidden="true">CC</div><div class="name">Cristovao Cacombe</div><div class="role">Data Science Analyst</div></div>
            <div class="person-card tilt"><div class="person-avatar" aria-hidden="true">AM</div><div class="name">Alamou Shola Mouhsine Daouda</div><div class="role">Data Science Analyst</div></div>
            <div class="person-card tilt"><div class="person-avatar" aria-hidden="true">ES</div><div class="name">Eda Nur Saruhan</div><div class="role">Data Science Analyst</div></div>
          </div>
        </div>
      </div>
    </section>

    <section class="cta-band" id="collaborate">
      <div class="wrap reveal">
        <span class="eyebrow" data-n="10" style="justify-content:center;">Partner with us</span>
        <h2>Four ways to build with SDG AI Lab.</h2>
        <p class="desc">Co-develop AI solutions · Research &amp; policy advisory · Build your team's capacity · Access vetted tech talent — from prototype to deployment.</p>
        <div class="cta-actions">
          <a href="mailto:dina.akylbekova@undp.org" class="btn btn-gradient btn-magnetic">Book a demo</a>
          <a href="mailto:dina.akylbekova@undp.org" class="btn btn-ghost">dina.akylbekova@undp.org</a>
        </div>
      </div>
    </section>
  </div>

  <style>
    .marina-team-page {
      --bg: #15181C;
      --bg-raised: #1B1F24;
      --bg-elevated: #21262C;
      --border: #2C323A;
      --border-soft: #24292F;
      --text: #D9DDE2;
      --text-dim: #8D96A1;
      --text-mid: #B7BFC7;
      --text-faint: #666F79;
      --teal: #22D3B8;
      --blue: #4C86FF;
      --amber: #FFAA3D;
      --display: 'Open Sans', sans-serif;
      --body: 'Open Sans', sans-serif;
      background: var(--bg);
      color: var(--text);
      font-family: var(--body);
      line-height: 1.5;
      overflow-x: hidden;
    }

    .marina-team-page *,
    .marina-team-page *::before,
    .marina-team-page *::after { box-sizing: border-box; }
    .marina-team-page a { color: inherit; text-decoration: none; }
    .marina-team-page section[id] { scroll-margin-top: 84px; }

    .marina-team-page .wrap {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 40px;
    }

    .marina-team-page .eyebrow {
      font-family: var(--body);
      font-size: 0.88rem;
      font-weight: 600;
      color: var(--text-mid);
      display: flex;
      align-items: baseline;
      gap: 10px;
    }
    .marina-team-page .eyebrow::before {
      content: attr(data-n);
      font-family: var(--display);
      font-weight: 600;
      font-size: 0.88rem;
      color: var(--teal);
    }

    .marina-team-page h1,
    .marina-team-page h2,
    .marina-team-page h3 {
      font-family: var(--display);
      font-weight: 700;
      letter-spacing: -0.015em;
      color: var(--text);
      margin: 0;
    }

    .marina-team-page .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 100px;
      padding: 11px 22px;
      border: 1px solid transparent;
      font-weight: 650;
      font-size: 0.88rem;
      transition: box-shadow .2s ease, transform .2s ease, background .2s ease, border-color .2s ease;
    }
    .marina-team-page .btn:hover { transform: translateY(-1px); }
    .marina-team-page .btn-gradient {
      background: linear-gradient(100deg, var(--teal), var(--blue) 70%, var(--amber));
      color: #04141a;
      box-shadow: 0 0 0 1px rgba(255,255,255,.08) inset, 0 8px 30px -8px rgba(34,211,184,.55);
    }
    .marina-team-page .btn-ghost {
      border-color: var(--border);
      background: transparent;
      color: var(--text);
    }
    .marina-team-page .btn-ghost:hover {
      border-color: var(--text-dim);
      background: rgba(255,255,255,.03);
    }

    .marina-team-page .band {
      padding: 56px 0;
      border-bottom: 1px solid var(--border-soft);
    }
    .marina-team-page #team { padding-top: 132px; }

    .marina-team-page .band-head {
      display: grid;
      grid-template-columns: 0.9fr 1.1fr;
      gap: 60px;
      margin-bottom: 72px;
    }
    .marina-team-page .band-head .eyebrow { grid-column: 1 / -1; }
    .marina-team-page .band-head h2 {
      font-size: clamp(1.9rem, 3.4vw, 2.7rem);
      line-height: 1.18;
      letter-spacing: -0.015em;
      margin-top: 22px;
    }

    .marina-team-page .team-group { margin-bottom: 48px; }
    .marina-team-page .team-group:last-child { margin-bottom: 0; }
    .marina-team-page .team-group h3 {
      font-family: var(--body);
      font-size: 0.72rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--text-faint);
      font-weight: 600;
      margin-bottom: 20px;
    }
    .marina-team-page .team-row {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: 20px;
    }
    .marina-team-page .person-card {
      border: 1px solid var(--border-soft);
      border-radius: 14px;
      padding: 22px 18px;
      background: var(--bg-raised);
      transition: border-color .2s ease, transform .2s ease;
    }
    .marina-team-page .person-card:hover {
      border-color: var(--border);
      transform: translateY(-2px);
    }
    .marina-team-page .person-avatar {
      width: 64px;
      height: 64px;
      border-radius: 50%;
      overflow: hidden;
      background:
        radial-gradient(circle at 30% 28%, rgba(76, 134, 255, .45), transparent 34%),
        linear-gradient(135deg, rgba(34, 211, 184, .16), rgba(76, 134, 255, .14)),
        var(--bg-elevated);
      border: 1px solid rgba(255, 255, 255, .06);
      color: var(--text-mid);
      margin-bottom: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: .8rem;
      font-weight: 800;
      letter-spacing: .08em;
    }
    .marina-team-page .person-card .name {
      font-size: 0.86rem;
      font-weight: 600;
      color: var(--text);
      line-height: 1.3;
    }
    .marina-team-page .person-card .role {
      font-size: 0.76rem;
      color: var(--text-dim);
      margin-top: 5px;
    }

    .marina-team-page .cta-band {
      padding: 130px 0;
      text-align: center;
      border-bottom: 1px solid var(--border-soft);
      position: relative;
    }
    .marina-team-page .cta-band::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(680px 340px at 50% 0%, rgba(34,211,184,.07), transparent 70%), radial-gradient(480px 280px at 85% 30%, rgba(76,134,255,.05), transparent 70%);
      pointer-events: none;
    }
    .marina-team-page .cta-band .wrap { position: relative; z-index: 1; }
    .marina-team-page .cta-band h2 {
      font-size: clamp(2.1rem, 4.6vw, 3.6rem);
      line-height: 1.08;
      letter-spacing: -0.015em;
      margin: 22px auto 34px;
      max-width: 820px;
    }
    .marina-team-page .cta-band .desc {
      max-width: 520px;
      margin: 0 auto 40px;
      color: var(--text-dim);
      line-height: 1.6;
    }
    .marina-team-page .cta-actions {
      display: flex;
      justify-content: center;
      gap: 18px;
      flex-wrap: wrap;
    }

    @media (max-width:900px) {
      .marina-team-page .team-row { grid-template-columns: repeat(3, 1fr); }
    }
    @media (max-width:800px) {
      .marina-team-page .band-head {
        grid-template-columns: 1fr;
        gap: 26px;
      }
    }
    @media (max-width:640px) {
      .marina-team-page .wrap { padding: 0 20px; }
    }
    @media (max-width:560px) {
      .marina-team-page .team-row { grid-template-columns: repeat(2, 1fr); }
    }
  </style>
</BaseLayout>
