---
import BaseLayout from '../components/layout/BaseLayout.astro';

const marinaAsset = (path: string) => `https://sdg-dark.netlify.app/${path}`;

const groups = [
  {
    title: 'Coordination · Research & Advisory',
    members: [
      ['gokhan-dikmener.jpg', 'Gokhan Dikmener', 'Chief Technology Advisor'],
      ['dina-akyibekova.jpg', 'Dina Akyibekova', 'Programme Specialist'],
      ['cansu-ozgur.jpg', 'Cansu Ozgur', 'Programme Analyst'],
      ['luka-ozay.jpg', 'Luka Ozay', 'Research Intern'],
      ['ihsan-bilgin.jpg', 'Ihsan Bilgin', 'Research Intern'],
    ],
  },
  {
    title: 'GIS & GeoAI · Software Development',
    members: [
      ['alper-dincer.jpg', 'Alper Dincer', 'GIS Analyst'],
      ['salsabila-prasetya.jpg', 'Salsabila Prasetya', 'GIS Analyst'],
      ['aykut-sevim.jpg', 'Aykut Sevim', 'Software Dev Specialist'],
      ['jackson-onyango.jpg', 'Jackson Onyango', 'Full Stack Developer'],
      ['josue-ushindi.jpg', 'Josue Ushindi', 'Full Stack Developer'],
    ],
  },
  {
    title: 'NLP / LLM · Training & Data Science',
    members: [
      ['muhammed-suleman.jpg', 'Muhammed Suleman', 'Data Scientist Fellow'],
      ['mert-atay.jpg', 'Mert Atay', 'Data Science Analyst'],
      ['ipek-beril-benli.jpg', 'Ipek Beril Benli', 'Programme Analyst'],
      ['cristovao-cacombe.jpg', 'Cristovao Cacombe', 'Data Science Analyst'],
      [
        'alamou-shola-mouhsine-daouda.jpg',
        'Alamou Shola Mouhsine Daouda',
        'Data Science Analyst',
      ],
      ['eda-nur-saruhan.jpg', 'Eda Nur Saruhan', 'Data Science Analyst'],
    ],
  },
];
---

<BaseLayout
  title="Our Team — SDG AI Lab"
  description="SDG AI Lab team organized across coordination, research, advisory, GIS, GeoAI, software development, NLP, LLM, training and data science groups."
>
  <div class="marina-team-page" id="main">
    <section class="band" id="team">
      <div class="wrap">
        <div class="band-head reveal">
          <h1>Six working groups, <span class="grad">one</span> lab.</h1>
        </div>

        {
          groups.map((group) => (
            <div class="team-group reveal">
              <h2>{group.title}</h2>
              <div class="team-row">
                {group.members.map(([file, name, role]) => (
                  <article class="person-card">
                    <div class="person-avatar">
                      <img
                        src={marinaAsset(`assets/team/${file}`)}
                        alt=""
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                    <div class="name">{name}</div>
                    <div class="role">{role}</div>
                  </article>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>
  </div>

  <style>
    .marina-team-page {
      --bg: #15181c;
      --bg-raised: #1b1f24;
      --bg-elevated: #21262c;
      --border: #2c323a;
      --border-soft: #24292f;
      --text: #d9dde2;
      --text-dim: #a0a8b2;
      --text-mid: #b7bfc7;
      --text-faint: #666f79;
      --teal: #0383ae;
      --blue: #1c61ac;
      --amber: #6ec6e8;
      --display: 'Cabinet Grotesk', sans-serif;
      --body: 'Inter', sans-serif;
      background: var(--bg);
      color: var(--text);
      font-family: var(--body);
      line-height: 1.5;
      overflow-x: hidden;
    }

    .marina-team-page *,
    .marina-team-page *::before,
    .marina-team-page *::after {
      box-sizing: border-box;
    }
    .marina-team-page a {
      color: inherit;
      text-decoration: none;
    }
    .marina-team-page section[id] {
      scroll-margin-top: 84px;
    }

    .marina-team-page .wrap {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 40px;
    }

    .marina-team-page h1,
    .marina-team-page h2 {
      font-family: var(--display);
      font-weight: 700;
      letter-spacing: -0.015em;
      color: var(--text);
      margin: 0;
    }

    .marina-team-page .grad {
      background: linear-gradient(120deg, var(--teal), var(--blue));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .marina-team-page .band {
      padding: 56px 0 80px;
      border-bottom: 1px solid var(--border-soft);
    }
    .marina-team-page #team {
      padding-top: 150px;
    }

    .marina-team-page .band-head {
      margin-bottom: 72px;
    }
    .marina-team-page .band-head h1 {
      font-size: clamp(2.15rem, 4vw, 3.3rem);
      line-height: 1.06;
      letter-spacing: -0.03em;
      max-width: 16ch;
    }

    .marina-team-page .team-group {
      margin-bottom: 48px;
    }
    .marina-team-page .team-group:last-child {
      margin-bottom: 0;
    }
    .marina-team-page .team-group h2 {
      font-family: var(--body);
      font-size: 0.72rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--text-faint);
      font-weight: 600;
      margin-bottom: 20px;
    }
    .marina-team-page .team-row {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(215px, 1fr));
      gap: 20px;
    }
    .marina-team-page .person-card {
      border: 1px solid var(--border-soft);
      border-radius: 16px;
      padding: 26px 22px;
      background: var(--bg-raised);
      transition:
        border-color 0.2s ease,
        transform 0.2s ease;
    }
    .marina-team-page .person-card:hover {
      border-color: var(--border);
      transform: translateY(-2px);
    }
    .marina-team-page .person-avatar {
      width: 104px;
      height: 104px;
      border-radius: 50%;
      overflow: hidden;
      background: transparent;
      border: 1px solid var(--border-soft);
      margin-bottom: 20px;
    }
    .marina-team-page .person-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .marina-team-page .person-card .name {
      font-size: 1rem;
      font-weight: 600;
      color: var(--text);
      line-height: 1.3;
    }
    .marina-team-page .person-card .role {
      font-size: 0.84rem;
      color: var(--text-dim);
      margin-top: 6px;
      line-height: 1.4;
    }

    .marina-team-page .reveal {
      opacity: 0;
      transform: translateY(24px);
      transition:
        opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
        transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .marina-team-page .reveal.is-visible {
      opacity: 1;
      transform: none;
    }

    @media (max-width: 900px) {
      .marina-team-page .team-row {
        grid-template-columns: repeat(3, 1fr);
      }
    }
    @media (max-width: 640px) {
      .marina-team-page .wrap {
        padding: 0 20px;
      }
    }
    @media (max-width: 560px) {
      .marina-team-page .team-row {
        grid-template-columns: repeat(2, 1fr);
      }
      .marina-team-page .person-avatar {
        width: 84px;
        height: 84px;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .marina-team-page .reveal {
        opacity: 1;
        transform: none;
        transition: none;
      }
    }
  </style>

  <script>
    const items = document.querySelectorAll('.marina-team-page .reveal');
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) =>
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }),
        { threshold: 0.12 },
      );
      items.forEach((item) => observer.observe(item));
    } else {
      items.forEach((item) => item.classList.add('is-visible'));
    }
  </script>
</BaseLayout>
