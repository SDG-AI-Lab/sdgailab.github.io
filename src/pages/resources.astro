---
import { withBase } from '../lib/url';
import BaseLayout from '../components/layout/BaseLayout.astro';
---

<BaseLayout
  title="Resources - SDG AI Lab"
  description="Resources, publications, toolkits and reusable guidance from the SDG AI Lab."
>
  <section class="section-padding bg-white">
    <div class="container-narrow">
      <p class="section-label">Knowledge hub</p>
      <h1 class="mt-3 text-3xl font-bold text-slate-950 sm:text-4xl">Resources</h1>
      <p class="mt-4 max-w-3xl text-lg leading-8 text-slate-600">
        A dedicated space for publications, toolkits, responsible-AI guidance and reusable technical outputs from the Lab's work.
      </p>

      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {[
          ['Publications', 'Reports, research notes and lessons from applied AI work.'],
          ['Toolkits', 'Templates, checklists and practical methods for project teams.'],
          ['Open-source outputs', 'Repositories, model cards, data statements and reusable code.'],
          ['Responsible AI', 'Risk, governance, evaluation and human-oversight guidance.'],
        ].map(([title, body]) => (
          <article class="rounded-xl border border-slate-200 bg-slate-50 p-6">
            <h2 class="text-lg font-bold text-slate-950">{title}</h2>
            <p class="mt-3 text-sm leading-6 text-slate-600">{body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding bg-slate-50" aria-labelledby="resource-readiness-heading">
    <div class="container-narrow grid gap-10 lg:grid-cols-[.8fr_1.2fr]">
      <div>
        <p class="section-label">Resource standards</p>
        <h2 id="resource-readiness-heading" class="mt-3 text-3xl font-bold text-slate-950 sm:text-4xl">
          What each resource will include
        </h2>
        <p class="mt-4 leading-7 text-slate-600">
          Resources should be easy to evaluate before download. Each published item will include enough context for users to understand its audience, source, status and relationship to Lab work.
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {[
          'Plain-language summary',
          'Authors, date and version status',
          'Related project or service',
          'Format, language and accessibility notes',
          'Responsible-use limitations where relevant',
          'Clear contact or next step',
        ].map((item) => (
          <div class="flex gap-3 rounded-lg border border-slate-200 bg-white p-4">
            <span class="mt-1 h-2.5 w-2.5 shrink-0 rounded-full bg-primary"></span>
            <p class="text-sm font-semibold text-slate-700">{item}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding bg-white" aria-labelledby="resources-in-preparation-heading">
    <div class="container-narrow rounded-2xl border border-slate-200 bg-white p-8 shadow-sm sm:p-10">
      <p class="section-label">In preparation</p>
      <h2 id="resources-in-preparation-heading" class="mt-3 text-3xl font-bold text-slate-950 sm:text-4xl">Resources are being prepared</h2>
      <p class="mt-4 max-w-3xl leading-7 text-slate-600">
        This section is being developed as a curated knowledge hub. For now, visit the newsroom and project pages for available updates.
      </p>
      <div class="mt-7 flex flex-col gap-3 sm:flex-row">
        <a href={withBase('/news')} data-analytics-event="cta_click" data-analytics-category="resources" data-analytics-label="Resources visit newsroom" class="inline-flex min-h-12 items-center justify-center rounded-md bg-primary px-6 py-3 text-sm font-bold text-white shadow transition hover:bg-primary-dark">
          Visit newsroom
        </a>
        <a href={withBase('/projects')} data-analytics-event="cta_click" data-analytics-category="resources" data-analytics-label="Resources explore projects" class="inline-flex min-h-12 items-center justify-center rounded-md border border-slate-300 px-6 py-3 text-sm font-bold text-slate-700 transition hover:border-primary hover:text-primary">
          Explore projects
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
