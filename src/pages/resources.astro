---
import { withBase } from '../lib/url';
import BaseLayout from '../components/layout/BaseLayout.astro';
import { sampleNews } from '../data/sampleContent';
---

<BaseLayout
  title="Resources - SDG AI Lab"
  description="Resources, publications, toolkits and reusable guidance from the SDG AI Lab."
>
  <section class="section-padding bg-white">
    <div class="container-narrow">
      <p class="section-label">Knowledge hub</p>
      <h1 class="mt-3 text-3xl font-bold text-slate-950 sm:text-4xl">Resources</h1>
      <p class="mt-4 max-w-3xl text-lg leading-8 text-slate-600">
        A dedicated space for research notes, toolkits, responsible-AI guidance and reusable technical outputs. This gives project work a place to become useful beyond a single prototype.
      </p>

      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {[
          ['Publications', 'Reports, research notes and lessons from applied AI work.'],
          ['Toolkits', 'Templates, checklists and practical methods for project teams.'],
          ['Open-source outputs', 'Approved repositories, model cards, data statements and reusable code.'],
          ['Responsible AI', 'Risk, governance, evaluation and human-oversight guidance.'],
        ].map(([title, body]) => (
          <article class="rounded-xl border border-slate-200 bg-slate-50 p-6">
            <h2 class="text-lg font-bold text-slate-950">{title}</h2>
            <p class="mt-3 text-sm leading-6 text-slate-600">{body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding bg-slate-50" aria-labelledby="resource-readiness-heading">
    <div class="container-narrow grid gap-10 lg:grid-cols-[.8fr_1.2fr]">
      <div>
        <p class="section-label">Before publication</p>
        <h2 id="resource-readiness-heading" class="mt-3 text-3xl font-bold text-slate-950 sm:text-4xl">
          Resource readiness checklist
        </h2>
        <p class="mt-4 leading-7 text-slate-600">
          Benchmark sites make resources easy to trust. Before a resource is published, it should be clear who it is for, how it was produced and what limitations apply.
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {[
          'Audience and use case are clear',
          'Methods and data sources are documented',
          'Responsible-use limitations are stated',
          'Owner/contact is identified',
          'Publication approval is confirmed',
          'Related project or output is linked',
        ].map((item) => (
          <div class="flex gap-3 rounded-lg border border-slate-200 bg-white p-4">
            <span class="mt-1 h-2.5 w-2.5 shrink-0 rounded-full bg-primary"></span>
            <p class="text-sm font-semibold text-slate-700">{item}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding bg-white" aria-labelledby="sample-resources-heading">
    <div class="container-narrow">
      <div class="mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <p class="section-label">Starting point</p>
          <h2 id="sample-resources-heading" class="mt-3 text-3xl font-bold text-slate-950 sm:text-4xl">Latest resource examples</h2>
        </div>
        <a href={withBase('/news')} class="text-sm font-bold text-primary hover:underline">View newsroom</a>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        {sampleNews.map((item) => (
          <article class="rounded-xl border border-slate-200 bg-white p-7 shadow-sm">
            <p class="text-xs font-bold uppercase tracking-wider text-amber-700">Sample content</p>
            <h3 class="mt-3 text-xl font-bold text-slate-950">{item.title}</h3>
            <p class="mt-3 text-sm leading-6 text-slate-600">{item.summary}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
