---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import ProjectList from '../../islands/ProjectList';
import { impactAreas } from '../../data/sampleContent';
---

<BaseLayout title="Projects - SDG AI Lab">
  <section class="section-padding">
    <div class="container-narrow">
      <p class="section-label">Portfolio</p>
      <h1 class="mt-3 text-3xl sm:text-4xl font-bold text-gray-900 mb-4">Projects</h1>
      <p class="max-w-3xl text-lg leading-8 text-gray-600 mb-8">
        Explore the SDG AI Lab portfolio: applied AI, data science and machine-learning work designed around development challenges, responsible methods and reusable learning.
      </p>

      <div class="mb-10 grid gap-4 rounded-xl border border-slate-200 bg-slate-50 p-5 md:grid-cols-4">
        {[
          ['Challenge', 'What development problem is being addressed?'],
          ['Solution', 'What approach, tool or prototype is being tested?'],
          ['Impact', 'What changed, or what evidence is being generated?'],
          ['Resources', 'What can others reuse: methods, code, reports or lessons?'],
        ].map(([title, body]) => (
          <article class="rounded-lg bg-white p-4 shadow-sm">
            <h2 class="text-sm font-bold uppercase tracking-wider text-primary">{title}</h2>
            <p class="mt-2 text-sm leading-6 text-slate-600">{body}</p>
          </article>
        ))}
      </div>

      <div class="mb-8 flex flex-wrap gap-2" aria-label="Portfolio themes">
        {['Responsible AI', 'Data readiness', 'Prototype', 'Internal tool', 'Published output', 'SDG alignment'].map((label) => (
          <span class="rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-semibold text-slate-600">{label}</span>
        ))}
      </div>

      <section class="mb-10 rounded-2xl border border-blue-100 bg-blue-50 p-6 sm:p-8" aria-labelledby="portfolio-language-heading">
        <div class="grid gap-6 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
          <div>
            <p class="section-label">Portfolio language</p>
            <h2 id="portfolio-language-heading" class="mt-3 text-2xl font-bold text-slate-950">
              How to read this portfolio
            </h2>
            <p class="mt-4 text-sm leading-7 text-slate-700">
              The Lab's portfolio brings together project work, reusable methods, technical outputs and implementation experience in one place so visitors can understand what was built, where it was applied and what can be reused.
            </p>
          </div>

          <div class="grid gap-4 md:grid-cols-3">
            {[
              ['Solution', 'A reusable tool, product, platform, model, dashboard or methodology.'],
              ['Project', 'A time-bound implementation or case study in a specific development context.'],
              ['Service', 'Expertise or support the Lab can provide, such as advisory, prototyping, research or training.'],
            ].map(([title, body]) => (
              <article class="rounded-xl border border-blue-100 bg-white p-5 shadow-sm">
                <h3 class="text-base font-bold text-slate-950">{title}</h3>
                <p class="mt-3 text-sm leading-6 text-slate-600">{body}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="mb-10 rounded-2xl border border-slate-200 bg-slate-50 p-6 sm:p-8" aria-labelledby="impact-area-heading">
        <div class="grid gap-8 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
          <div>
            <p class="section-label">Portfolio map</p>
            <h2 id="impact-area-heading" class="mt-3 text-2xl font-bold text-slate-950">
              How the Lab organizes its work
            </h2>
            <p class="mt-4 text-sm leading-7 text-slate-600">
              Projects are grouped into six practical domains, from geospatial intelligence and NLP tools to resilience, digital finance, skills development and advisory support. Use the filters below to explore the current portfolio.
            </p>
          </div>

          <div class="grid gap-3 sm:grid-cols-2">
            {impactAreas.map((area) => (
              <article class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
                <div class="flex items-start justify-between gap-3">
                  <h3 class="font-bold text-slate-950">{area.title}</h3>
                  {/* <span class="shrink-0 rounded-full bg-primary-50 px-2.5 py-1 text-[11px] font-bold text-primary">{area.timeline}</span> */}
                </div>
                <p class="mt-2 text-sm leading-6 text-slate-600">{area.summary}</p>
                <p class="mt-3 text-xs font-semibold text-slate-500">
                  Examples: {area.examples.slice(0, 2).join(', ')}
                </p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <ProjectList client:load />
    </div>
  </section>
</BaseLayout>
