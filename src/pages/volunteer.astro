---
import BaseLayout from '../components/layout/BaseLayout.astro';
import PageContent from '../islands/PageContent';
---

<BaseLayout title="Volunteer - SDG AI Lab">
  <section class="section-padding">
    <div class="container-narrow">
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-8">Volunteering with Us</h1>
      <PageContent client:load pageSlug="volunteer" sectionSlug="main" />

      <div class="mt-12 grid gap-5 md:grid-cols-3">
        <article class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
          <h2 class="text-lg font-bold text-slate-950">Contribute technical skills</h2>
          <p class="mt-3 text-sm leading-6 text-slate-600">Support data analysis, responsible AI review, prototyping, documentation or open-source implementation.</p>
        </article>
        <article class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
          <h2 class="text-lg font-bold text-slate-950">Work with real development needs</h2>
          <p class="mt-3 text-sm leading-6 text-slate-600">Volunteer contributions should connect to defined project questions, users, safeguards and expected outputs.</p>
        </article>
        <article class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
          <h2 class="text-lg font-bold text-slate-950">Leave reusable knowledge</h2>
          <p class="mt-3 text-sm leading-6 text-slate-600">Where possible, contributions should result in documented methods, lessons, tools or resources that others can build on.</p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
