---
import BaseLayout from '../components/layout/BaseLayout.astro';
import PartnerLogos from '../islands/PartnerLogos';
---

<BaseLayout title="Partners - SDG AI Lab">
  <section class="section-padding">
    <div class="container-narrow">
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-2">Our Partners</h1>
      <p class="text-lg text-gray-600 mb-8">
        We collaborate with leading international organizations, government agencies, and technology companies
        to advance the Sustainable Development Goals through AI and machine learning.
      </p>

      <div class="mb-10 grid gap-4 md:grid-cols-4">
        {[
          ['Institutional partners', 'Strategic partners supporting long-term development outcomes.'],
          ['Technical partners', 'Teams contributing data, engineering, AI and product expertise.'],
          ['Research collaborators', 'Academic and policy partners supporting evidence and learning.'],
          ['Implementation partners', 'Country, regional and thematic teams applying solutions in practice.'],
        ].map(([title, body]) => (
          <article class="rounded-xl border border-slate-200 bg-slate-50 p-5">
            <h2 class="text-base font-bold text-slate-950">{title}</h2>
            <p class="mt-2 text-sm leading-6 text-slate-600">{body}</p>
          </article>
        ))}
      </div>

      <PartnerLogos client:load />
    </div>
  </section>
</BaseLayout>
