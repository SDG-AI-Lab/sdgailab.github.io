---
import { withBase } from '../lib/url';
import BaseLayout from '../components/layout/BaseLayout.astro';
import PageContent from '../islands/PageContent';
import StatsCards from '../islands/StatsCards';

const evidenceQuestions = [
  ['What changed?', 'Outcome, output, decision improvement or capacity change.'],
  ['Where did it happen?', 'Country, partner, institution or implementation setting.'],
  ['How do we know?', 'Source record, project page, report, dashboard or verified metric.'],
  ['What can be reused?', 'Code, method, template, lessons, safeguards or implementation notes.'],
];

const evolutionSteps = [
  ['Explore', 'Identify development challenges where AI, data or digital methods can add practical value.'],
  ['Prototype', 'Co-design testable tools, methods and workflows with domain experts and partners.'],
  ['Validate', 'Review usability, safeguards, data readiness and evidence before broader publication or reuse.'],
  ['Reuse', 'Package lessons, resources and technical material so other teams can adapt what works.'],
];
---

<BaseLayout
  title="About - SDG AI Lab"
  description="About SDG AI Lab, its mission, approach, evolution and evidence model."
>
  <section class="section-padding bg-white">
    <div class="container-narrow">
      <p class="section-label">About</p>
      <h1 class="mt-3 max-w-4xl text-3xl font-bold text-slate-950 sm:text-5xl">About SDG AI Lab</h1>
      <div class="mt-6 max-w-3xl text-lg leading-8 text-slate-600">
        <PageContent client:load pageSlug="about" sectionSlug="about-sdgailab" />
      </div>
    </div>
  </section>

  <section class="section-padding bg-slate-50" aria-labelledby="approach-heading">
    <div class="container-narrow grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
      <div>
        <p class="section-label">How we work</p>
        <h2 id="approach-heading" class="mt-3 text-3xl font-bold text-slate-950 sm:text-4xl">Problem-first, evidence-led and reusable</h2>
        <div class="mt-5 leading-7 text-slate-600">
          <PageContent client:load pageSlug="about" sectionSlug="our-approach" />
        </div>
      </div>
      <div class="grid gap-4 sm:grid-cols-3">
        <article class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
          <h3 class="text-lg font-bold text-slate-950">Who we support</h3>
          <p class="mt-3 text-sm leading-6 text-slate-600">UNDP teams, public-sector partners, researchers and collaborators exploring responsible AI for sustainable development.</p>
        </article>
        <article class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
          <h3 class="text-lg font-bold text-slate-950">How we work</h3>
          <p class="mt-3 text-sm leading-6 text-slate-600">Structured discovery, planning, implementation and review cycles, with technical work grounded in real development needs.</p>
        </article>
        <article class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
          <h3 class="text-lg font-bold text-slate-950">What we publish</h3>
          <p class="mt-3 text-sm leading-6 text-slate-600">Project profiles, research notes, toolkits, responsible-AI lessons and open resources that are ready for public use.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section-padding bg-white" aria-labelledby="evolution-heading">
    <div class="container-narrow">
      <div class="mb-9 max-w-3xl">
        <p class="section-label">Our evolution</p>
        <h2 id="evolution-heading" class="mt-3 text-3xl font-bold text-slate-950 sm:text-4xl">From exploration to reusable development tools</h2>
        <p class="mt-4 leading-7 text-slate-600">
          The Lab's work has evolved around a practical cycle: understand the development challenge, build responsibly, validate the evidence and make useful outputs easier to reuse.
        </p>
      </div>
      <div class="grid gap-4 md:grid-cols-4">
        {evolutionSteps.map(([title, body], index) => (
          <article class="relative rounded-2xl border border-slate-200 bg-slate-50 p-6 shadow-sm">
            <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-full bg-primary text-sm font-bold text-white">{String(index + 1).padStart(2, '0')}</div>
            <h3 class="text-lg font-bold text-slate-950">{title}</h3>
            <p class="mt-3 text-sm leading-6 text-slate-600">{body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="impact" class="section-padding bg-slate-50" aria-labelledby="impact-heading">
    <div class="container-narrow">
      <div class="mb-9 max-w-3xl">
        <p class="section-label">Impact and evidence</p>
        <h2 id="impact-heading" class="mt-3 text-3xl font-bold text-slate-950 sm:text-4xl">Figures should be sourced, current and tied to portfolio evidence</h2>
        <p class="mt-4 leading-7 text-slate-600">
          Impact information should connect back to projects, resources, technical material and partner context, so visitors can understand both what changed and how the work can be reused.
        </p>
      </div>
      <StatsCards client:load />
    </div>
  </section>

  <section class="section-padding bg-white" aria-labelledby="evidence-heading">
    <div class="container-narrow grid gap-8 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <p class="section-label">Evidence model</p>
        <h2 id="evidence-heading" class="mt-3 text-3xl font-bold text-slate-950 sm:text-4xl">Every impact claim should answer four questions</h2>
        <p class="mt-4 leading-7 text-slate-600">
          This gives reviewers a simple editorial checklist and keeps public claims connected to verifiable portfolio records.
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {evidenceQuestions.map(([title, body]) => (
          <article class="rounded-xl border border-slate-200 bg-slate-50 p-5">
            <h3 class="font-bold text-slate-950">{title}</h3>
            <p class="mt-3 text-sm leading-6 text-slate-600">{body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding bg-primary-900 text-white">
    <div class="container-narrow rounded-2xl border border-white/15 bg-white/5 p-6 shadow-sm sm:p-8">
      <p class="text-sm font-bold uppercase tracking-[0.18em] text-blue-300">Continue exploring</p>
      <h2 class="mt-3 text-3xl font-bold sm:text-4xl">See the work behind the Lab's approach</h2>
      <p class="mt-4 max-w-3xl leading-7 text-blue-100">
        Browse the project portfolio and knowledge resources to see how methods, evidence and reusable outputs are documented.
      </p>
      <div class="mt-7 flex flex-col gap-3 sm:flex-row">
        <a href={withBase('/projects')} class="inline-flex min-h-12 items-center justify-center rounded-md bg-blue-500 px-6 py-3 text-sm font-bold text-white shadow transition hover:bg-blue-400">View projects</a>
        <a href={withBase('/resources')} class="inline-flex min-h-12 items-center justify-center rounded-md border border-white/30 px-6 py-3 text-sm font-bold text-white transition hover:border-white hover:bg-white/10">View resources</a>
      </div>
    </div>
  </section>
</BaseLayout>