---
import BaseLayout from '../components/layout/BaseLayout.astro';
import PageContent from '../islands/PageContent';
---

<BaseLayout title="About - SDG AI Lab">
  <section class="section-padding">
    <div class="container-narrow">
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-8">About SDG AI Lab</h1>

      <!-- <div class="mb-8">
        <p class="text-lg text-gray-600 leading-relaxed"> -->
          <PageContent client:load pageSlug="about" sectionSlug="about-sdgailab" />
        <!-- </p>
      </div> -->

      <h2 class="text-2xl font-bold text-gray-900 mb-4">Our Approach</h2>
      <PageContent client:load pageSlug="about" sectionSlug="our-approach" />

      <div class="mt-14 grid gap-6 md:grid-cols-3">
        <article class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
          <h2 class="text-lg font-bold text-slate-950">Who we support</h2>
          <p class="mt-3 text-sm leading-6 text-slate-600">UNDP teams, public-sector partners, researchers and collaborators exploring responsible AI for sustainable development.</p>
        </article>
        <article class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
          <h2 class="text-lg font-bold text-slate-950">How we work</h2>
          <p class="mt-3 text-sm leading-6 text-slate-600">Problem-first, evidence-led and iterative: from scoping and data readiness to prototypes, evaluation and reusable guidance.</p>
        </article>
        <article class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
          <h2 class="text-lg font-bold text-slate-950">What we publish</h2>
          <p class="mt-3 text-sm leading-6 text-slate-600">Project profiles, research notes, toolkits, responsible-AI lessons and open resources that are ready for public use.</p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
