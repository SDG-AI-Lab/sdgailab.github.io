---
import { withBase } from '../lib/url';
import BaseLayout from '../components/layout/BaseLayout.astro';
import PageContent from '../islands/PageContent';

const evolutionSteps = [
  [
    'Explore',
    'Identify development challenges where AI, data, or digital solutions can add practical value.',
  ],
  [
    'Prototype',
    'Co-design testable tools, methods, and workflows with domain experts and partners.',
  ],
  [
    'Validate',
    'Assess usability, safeguards, and data readiness, and review the evidence before broader publication or reuse.',
  ],
  [
    'Reuse',
    'Package lessons, resources, and technical materials so other teams can adapt what works.',
  ],
];
const approachHighlights = [
  'Formulating research questions and solution architecture, and matching the right expertise to each challenge',
  'Assembling and coordinating in-house engineers, developers, designers, and vetted technical specialists',
  'Structuring teams and workflows to support iterative testing and experimentation',
  'Overseeing R&D to uphold rigorous, high-quality standards throughout',
  'Delivering outputs as prototypes, technical architecture, reports, and presentations; built from the ground up or adapted from existing tools',
];
---

<BaseLayout
  title="About - SDG AI Lab"
  description="About SDG AI Lab, its mission, approach, evolution and evidence model."
>
  <section class="section-padding bg-lab-surface">
    <div class="container-narrow">
      <h1 class="mt-3 max-w-4xl text-3xl font-bold text-lab-text sm:text-5xl">
        About SDG AI Lab
      </h1>
      <div class="mt-6 max-w-5xl text-justify text-lg leading-8 text-lab-muted">
        <PageContent
          client:load
          pageSlug="about"
          sectionSlug="about-sdgailab"
        />
      </div>
    </div>
  </section>

  <section
    class="section-padding bg-lab-section"
    aria-labelledby="approach-heading"
  >
    <div
      class="container-narrow grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-start"
    >
      <div>
        <p class="section-label">How we work</p>
        <h2
          id="approach-heading"
          class="mt-3 text-3xl font-bold text-lab-text sm:text-4xl"
        >
          Problem-first, evidence-led and reusable
        </h2>
        <p class="mt-5 text-xl font-bold leading-8 text-lab-text">
          An agile, end-to-end approach to applied AI research for sustainable
          development.
        </p>
        <p class="mt-4 leading-7 text-lab-muted">
          The Lab combines research, technical delivery and coordination so
          development challenges can move from early framing to tested,
          documented and reusable outputs.
        </p>
      </div>
      <div class="grid gap-4">
        {
          approachHighlights.map((item, index) => (
            <article class="flex gap-4 rounded-xl border border-lab-border bg-lab-surface p-5 shadow-sm">
              <span class="mt-1 inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary text-sm font-bold text-lab-text">
                {String(index + 1).padStart(2, '0')}
              </span>
              <p class="text-sm font-semibold leading-6 text-lab-muted">
                {item}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  <section
    class="section-padding bg-lab-surface"
    aria-labelledby="evolution-heading"
  >
    <div class="container-narrow">
      <div class="mb-9 max-w-3xl">
        <p class="section-label">Our Methodology</p>
        <h2
          id="evolution-heading"
          class="mt-3 text-3xl font-bold text-lab-text sm:text-4xl"
        >
          From exploration to reusable development tools
        </h2>
        <p class="mt-4 leading-7 text-lab-muted">
          The Lab's work follows a practical cycle: understand the development
          challenge, build responsibly, validate the evidence, and package
          outputs for reuse.
        </p>
      </div>
      <div class="grid gap-4 md:grid-cols-4">
        {
          evolutionSteps.map(([title, body], index) => (
            <article class="relative rounded-2xl border border-lab-border bg-lab-section p-6 shadow-sm">
              <div class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-full bg-primary text-sm font-bold text-white">
                {String(index + 1).padStart(2, '0')}
              </div>
              <h3 class="text-lg font-bold text-lab-text">{title}</h3>
              <p class="mt-3 text-sm leading-6 text-lab-muted">{body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-padding bg-lab-base text-lab-text">
    <div
      class="container-narrow rounded-2xl border border-lab-border bg-lab-surface p-6 shadow-[0_18px_50px_rgba(0,0,0,0.22)] sm:p-8"
    >
      <p
        class="text-sm font-bold uppercase tracking-[0.18em] text-lab-accent-soft"
      >
        Continue exploring
      </p>
      <h2 class="mt-3 text-3xl font-bold sm:text-4xl">See the Lab's work</h2>
      <!-- <p class="mt-4 max-w-3xl leading-7 text-lab-muted">
        Browse the project portfolio and knowledge resources to see how methods,
        evidence and reusable outputs are documented.
      </p> -->
      <div class="mt-7 flex flex-col gap-3 sm:flex-row">
        <a
          href={withBase('/projects')}
          class="inline-flex min-h-12 items-center justify-center rounded-md bg-lab-accent px-6 py-3 text-sm font-bold text-white shadow transition hover:bg-primary-light"
          >View projects</a
        >
        <a
          href={withBase('/resources')}
          class="inline-flex min-h-12 items-center justify-center rounded-md border border-lab-border bg-lab-section px-6 py-3 text-sm font-bold text-lab-accent-soft transition hover:border-lab-accent/50 hover:bg-lab-elevated"
          >View publications</a
        >
      </div>
    </div>
  </section>
</BaseLayout>
